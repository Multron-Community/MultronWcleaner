<UserControl x:Class="Multron_Win_Cleaner.RotatingCleanIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="64" Height="64">

    <UserControl.Resources>
      
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever" SpeedRatio="1">
            <DoubleAnimation
                Storyboard.TargetName="IconRotate"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:1" SpeedRatio="1" />
        </Storyboard>
    </UserControl.Resources>

    <Image x:Name="IconImage"
           Source="/MultronWinCleaner;component/Assets/cleanIcon.png"
           Stretch="Uniform"
           RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
            <RotateTransform x:Name="IconRotate" Angle="0" />
        </Image.RenderTransform>
    </Image>
</UserControl>
