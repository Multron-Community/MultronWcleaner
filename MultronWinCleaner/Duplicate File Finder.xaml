<Window x:Class="MultronWinCleaner.Duplicate_File_Finder" Icon="pack://application:,,,/Assets/mwc_utilities.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        xmlns:local="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Multron Duplicate File Finder'}"
        Height="760" Width="980"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>
 
        <Style x:Key="BigCircularButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Heavy"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="70" BorderThickness="4" BorderBrush="#22FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="20" Direction="270" ShadowDepth="5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02" CenterX="70" CenterY="70"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="70" CenterY="70"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style> 
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewToggleStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="6,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
 
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="12" BorderBrush="#33000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="25" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
 
            <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" CornerRadius="12,12,0,0" MouseDown="TopBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                      
                        <TextBlock Text="{loc:Tr 'Multron Duplicate File Finder'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Opacity="0.8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="SettingsButton" Style="{StaticResource ModernButtonStyle}" Height="30" Click="SettingsButton_Click" Margin="0,0,8,0"
                                ToolTip="{loc:Tr 'Folders, file types and filters for the duplicate scan'}">
                            <StackPanel Orientation="Horizontal" Margin="10,0">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Settings'}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Click="MinimizeButton_Click" ToolTip="{loc:Tr 'Minimize'}" Margin="0,0,4,0"/>
                        <Button Content="&#xE922;" Style="{DynamicResource ChromeButtonStyle}" x:Name="buttonMaximize" Click="MaximizeButton_Click" ToolTip="{loc:Tr 'Maximize/Restore'}" Margin="0,0,4,0"/>
                        <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
                    </StackPanel>
                </Grid>
            </Border>
 
            <Grid Grid.Row="1" Margin="25,15,25,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
 
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,15">
                    <Button x:Name="MainActionButton" Content="{loc:Tr 'SCAN'}" Style="{StaticResource BigCircularButton}" Click="MainActionButton_Click"/>

                    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,15,0,5" FontSize="14" Foreground="{DynamicResource SecondaryText}">
                        <Run Text="{loc:Tr 'Ready to scan'}"/><LineBreak/><Run/>
                    </TextBlock>

                    <TextBlock x:Name="TotalSizeText" Text="{loc:Tr 'Recoverable Space: 0 MB'}" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Visibility="Collapsed"/>
                    <TextBlock x:Name="FilesScannedText" Text="" HorizontalAlignment="Center" FontSize="14" Opacity="0.7" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
  
                <StackPanel Grid.Row="1">
                    <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>
 
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="{loc:Tr 'Target Directories'}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <ListBox x:Name="FolderListBox" Height="120" Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10">
                                    <ListBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </ListBox.Resources>
                                </ListBox>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                          
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                          
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="{loc:Tr '+ Add Folder'}" Click="BrowseButton_Click" Style="{DynamicResource RoundedButtonStyle}" Height="30"/>
                                        <Button Grid.Column="2" Content="{loc:Tr '+ C:\\ Drive'}" Click="BtnAddDefault_Click" Style="{DynamicResource RoundedButtonStyle}" Height="30"/>
                                        <Button Grid.Column="4" Content="{loc:Tr 'Remove'}" Click="RemoveButton_Click" Style="{DynamicResource DangerButtonStyle}" Height="30"/>
                                    </Grid>

                                </Grid>
                            </StackPanel>

                         
                            <Border Grid.Column="1" Width="1" Background="{DynamicResource SeparatorBrush}" Margin="10,5,25,5" Opacity="0.5"/>
 
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Tr 'Scan Filters &amp; Data Options'}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{loc:Tr 'Min Size (KB):'}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="MinSizeTextBox" Text="100" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,12,0" PreviewTextInput="NumberValidationTextBox" ToolTip="{loc:Tr 'Files smaller than this will be ignored (e.g. 1024 for 1MB).'}"/>

                                    <TextBlock Grid.Column="2" Text="{loc:Tr 'Preset:'}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="3" x:Name="ExtensionPresetComboBox" Height="30" Style="{DynamicResource ModernComboBoxStyle}" SelectionChanged="ExtensionPresetComboBox_SelectionChanged">
                                        <ComboBoxItem Content="{loc:Tr 'All Files (*.*)'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Images Only'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Videos Only'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Music Only'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Documents Only'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Archives and Disk Images'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Programs and Installers'}"/>
                                        <ComboBoxItem x:Name="CustomPresetItem" Content="{loc:Tr 'Custom'}" IsSelected="True"/>
                                    </ComboBox>
                                </Grid>
 
                                <Grid Margin="0,0,0,10">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=CustomPresetItem, Path=IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr 'Extension Filter:'}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="ExtensionTextBox" Text="*.*" Style="{StaticResource ModernTextBox}" Height="30" ToolTip="{loc:Tr 'Example: *.mp4, *.jpg or *.* for all files'}"/>
                                </Grid>

                             
                            
                                <GroupBox Header="{loc:Tr 'Quick Extension Select'}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" Padding="5">
                                    <GroupBox.Style>
                                        <Style TargetType="GroupBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=CustomPresetItem, Path=IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </GroupBox.Style>
                                    <UniformGrid x:Name="QuickExtensionGrid" Columns="6">
                                        <CheckBox Content=".png" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".jpeg" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".jpg" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".webp" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".mp4" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".avi" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".mkv" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".mov" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".gif" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".bmp" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".heic" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".tiff" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".raw" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".svg" IsChecked="False" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".wmv" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".webm" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".flv" IsChecked="False" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".m4v" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".mpg" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".3gp" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".mp3" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".wav" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".flac" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".m4a" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".aac" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".ogg" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".pdf" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".docx" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".xlsx" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".pptx" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".txt" IsChecked="False" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".epub" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".zip" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".rar" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".7z" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".iso" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".exe" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".msi" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".apk" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".psd" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".tif" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".cr2" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".nef" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".arw" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".dng" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".mpeg" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".wma" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".opus" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".doc" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".xls" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".ppt" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".odt" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".ods" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".rtf" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".tar" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                        <CheckBox Content=".gz" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="2" Checked="ExtensionCheckBox_CheckedChanged" Unchecked="ExtensionCheckBox_CheckedChanged"/>
                                    </UniformGrid>
                                </GroupBox>

                                <CheckBox x:Name="CheckQualityCheckBox" Content="{loc:Tr 'Also list similar media (same name, different quality)'}" IsChecked="False" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" ToolTip="{loc:Tr 'Lists videos and images with the same name but different content, for example a 1080p and a 720p version. They are not identical, so they are marked SIMILAR and never selected for deletion automatically.'}"/>
                                <CheckBox x:Name="ShowHashCheckBox" Content="{loc:Tr 'Display SHA256 Hash in results tree'}" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" Checked="ShowHashCheckBox_Checked" Unchecked="ShowHashCheckBox_Unchecked"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                    
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="{loc:Tr 'Open Duplicates.json'}" Click="BtnOpenJson_Click" Style="{DynamicResource RoundedButtonStyle}" Height="34" ToolTip="{loc:Tr 'Opens the folder/file where scan results are saved.'}"/>
                                    <Button Grid.Column="2" Content="{loc:Tr 'Reset Findings'}" Click="BtnDeleteJson_Click" Style="{DynamicResource DangerButtonStyle}" Height="34" ToolTip="{loc:Tr 'Permanently deletes the saved duplicates cache file.'}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
 
                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="36" CornerRadius="18" VerticalAlignment="Center"
                            Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="0.85">
                        <Grid Margin="12,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.55" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{loc:Tr 'Search by File Name or SHA256 Hash...'}" Margin="8,0,0,0" FontSize="12.5" Opacity="0.45"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            <Button x:Name="SearchClear" Grid.Column="2" Content="✕" Width="22" Height="22" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextPrimary}" Click="SearchClear_Click" ToolTip="{loc:Tr 'Clear'}"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="SearchCountText" Grid.Column="1" Text="" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" Margin="15,0,0,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <RadioButton x:Name="TreeViewRadio" GroupName="DuplicateView" Content="{loc:Tr '🌳 Folders'}" Style="{StaticResource ViewToggleStyle}" Checked="ViewMode_Changed" ToolTip="{loc:Tr 'Show duplicates grouped by folder'}"/>
                        <RadioButton x:Name="SideBySideRadio" GroupName="DuplicateView" Content="{loc:Tr '⇄ Side by side'}" IsChecked="True" Style="{StaticResource ViewToggleStyle}" Checked="ViewMode_Changed" ToolTip="{loc:Tr 'Show each copy next to the original it was copied from'}"/>
                    </StackPanel>
                </Grid>
 
                <Border Grid.Row="3" Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                    <Grid>
                        <TreeView x:Name="DuplicatesTreeView" Visibility="Collapsed" 
                                  VirtualizingStackPanel.IsVirtualizing="True" 
                                  VirtualizingStackPanel.VirtualizationMode="Recycling" 
                                  Background="Transparent" 
                                  BorderThickness="0" 
                                  Foreground="{DynamicResource TextPrimary}">

                            <TreeView.Resources>
                            
                                <HierarchicalDataTemplate DataType="{x:Type local:FolderNodeModel}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Tr '📁 Open Folder'}" Tag="{Binding FullPath}" Click="ContextMenu_OpenFolder_Click"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>

                                        <TextBlock Text="📁" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                                        <Border Background="{DynamicResource AccentColor}" CornerRadius="12" Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="FolderBadge_Click" ToolTip="{loc:Tr 'Click to view every duplicate file inside this folder'}">
                                            <TextBlock Text="{Binding TotalDuplicateCount}" FontSize="12" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
 
                                <DataTemplate DataType="{x:Type local:FileNodeModel}">
                                    <Border Margin="0,4" CornerRadius="8" Padding="12,8" Background="{DynamicResource PanelBackground}" BorderBrush="#11000000" BorderThickness="1">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Tr '📄 Open File'}" Tag="{Binding FilePath}" Click="ContextMenu_OpenFile_Click"/>
                                                <MenuItem Header="{loc:Tr '📂 Open File Location'}" Tag="{Binding FilePath}" Click="ContextMenu_OpenFileLocation_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:Tr '🔍 Show Matching Files'}" Tag="{Binding}" Click="ContextMenu_ShowMatchingFiles_Click" IsEnabled="{Binding HasMatches}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForDeletion}" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>

                                            <TextBlock Grid.Column="1" Text="{Binding FileIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,15,0">
                                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Cursor="Hand" MouseLeftButtonUp="MatchSummary_Click" Tag="{Binding}" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMatches}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="🔗 " Foreground="{DynamicResource AccentColor}"/>
                                                    <Run Text="{Binding MatchSummary, Mode=OneWay}" Foreground="{DynamicResource AccentColor}" TextDecorations="Underline" FontSize="11"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding DisplayHash, Mode=OneWay}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHashVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="3" Background="{DynamicResource AccentColor}" Opacity="0.9" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedSize}" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </TreeView.Resources>

                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="False"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <ListBox x:Name="PairsListBox" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="0,4"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" DataContext="{Binding Copy}" CornerRadius="8" Padding="12,8" Background="{DynamicResource PanelBackground}" BorderBrush="#11000000" BorderThickness="1">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Tr '📄 Open File'}" Tag="{Binding FilePath}" Click="ContextMenu_OpenFile_Click"/>
                                                    <MenuItem Header="{loc:Tr '📂 Open File Location'}" Tag="{Binding FilePath}" Click="ContextMenu_OpenFileLocation_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForDeletion}" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand" ToolTip="{loc:Tr 'Delete this file when you click CLEAN'}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{Binding CopyBadgeColor}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CopyBadge}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding FileName}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FolderPath}" ToolTip="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding FormattedSize, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding CreatedText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="➜" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding RelationText}" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" DataContext="{Binding Original}" CornerRadius="8" Padding="12,8" Background="{DynamicResource PanelBackground}" BorderBrush="#11000000" BorderThickness="1">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Tr '📄 Open File'}" Tag="{Binding FilePath}" Click="ContextMenu_OpenFile_Click"/>
                                                    <MenuItem Header="{loc:Tr '📂 Open File Location'}" Tag="{Binding FilePath}" Click="ContextMenu_OpenFileLocation_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForDeletion}" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand" ToolTip="{loc:Tr 'Delete this file when you click CLEAN'}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FileIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#FF28A745" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{loc:Tr 'The oldest file with this content'}">
                                                            <TextBlock Text="{loc:Tr 'ORIGINAL'}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding FileName}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FolderPath}" ToolTip="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding FormattedSize, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding CreatedText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                      
                        <Border x:Name="LoadingOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="10" CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="6" Margin="0,0,0,20" Foreground="{DynamicResource AccentColor}" BorderThickness="0" Background="#33FFFFFF"/>
                                <TextBlock Text="{loc:Tr 'Loading previous scan, please wait...'}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
