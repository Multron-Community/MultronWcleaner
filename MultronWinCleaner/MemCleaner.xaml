<Window x:Class="MultronWinCleaner.MemCleaner" Icon="pack://application:,,,/Assets/mwc_utilities.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Memory Cleaner'}" Height="480" Width="920"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="{DynamicResource PanelBackground}" CornerRadius="16" Padding="0" Margin="12" Effect="{StaticResource DropShadowEffect}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="WindowDragMove" Background="Transparent" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Multron" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{loc:Tr ' Memory Cleaner'}" FontSize="18" FontWeight="Light" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1">
                    <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Click="MinimizeButton_Click" ToolTip="{loc:Tr 'Minimize'}" Margin="0,0,8,0"/>
                    <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" Background="{DynamicResource TextSecondary}" Opacity="0.1" VerticalAlignment="Bottom" Margin="20,0"/>

            <Grid Grid.Row="1" Margin="20,15,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">

                    <Grid Width="150" Height="150" Margin="0,0,0,25">
                        <Ellipse Width="150" Height="150" Stroke="{DynamicResource TextSecondary}" StrokeThickness="10" Opacity="0.1" />
                        <Path x:Name="ArcPath" Width="150" Height="150" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="None" RenderTransformOrigin="0.5,0.5">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#42A5F5" Offset="0"/>
                                    <GradientStop Color="#1565C0" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="RAM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RamUsagePercentText" Text="0%" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="10,0">
                        <TextBlock Text="{loc:Tr 'INFO'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                        <TextBlock x:Name="CpuNameText" Text="{loc:Tr 'Loading CPU...'}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CpuUsageText" Text="{loc:Tr 'CPU Load: %0'}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RamInfoText" Text="{loc:Tr 'RAM: 0 GB / 0 GB'}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="Status" Text="{loc:Tr 'Auto Clean Status: Idle'}" Foreground="{DynamicResource TextSecondary}" FontSize="13" TextAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource TextSecondary}" Opacity="0.1" Margin="0,10"/>
                <Border Grid.Column="3" Background="{DynamicResource TextSecondary}" Opacity="0.1" Margin="0,10"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,20,0" Height="262">
                    <Button Name="CleanButton" Height="50" Style="{StaticResource ModernButtonStyle}" Click="CleanMemoryButton_Click" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:Tr 'Clean Memory Now'}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="CleanedMemoryLabel" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#28A745" HorizontalAlignment="Center" Margin="0,0,0,25" />

                    <TextBlock Text="{loc:Tr 'CLEANING MODE'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                    <RadioButton x:Name="rbQuickClean" Content="{loc:Tr 'Quick Clean'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" IsChecked="True" Margin="0,0,0,8"/>
                    <RadioButton x:Name="rbDeepClean" Content="{loc:Tr 'Deep Clean'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Checked="rbDeepClean_Checked"/>
                    <RadioButton x:Name="rbDeepCleanAggresive" Content="{loc:Tr 'Deep Clean (Aggressive)'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="rbDeepCleanAgressive_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="{loc:Tr 'AUTOMATION &amp; PREFERENCES'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />
 
                    <CheckBox x:Name="chkSmartRAM" Content="{loc:Tr 'Enable Memory Monitor Widget'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="chkSmartRAM_Checked" Unchecked="chkSmartRAM_Unchecked" Margin="0,0,0,6"/>
 
                    <Button x:Name="btnResetWidgetLocation" Content="{loc:Tr '⌖ Reset Widget Location (Center)'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Background="#10000000" BorderBrush="Gray" BorderThickness="1" Cursor="Hand" Padding="12,6" HorizontalAlignment="Left" Margin="24,0,0,12" Click="btnResetWidgetLocation_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                         
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                             
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1A1E88E5"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF1E88E5"/>
                                                    <Setter Property="Foreground" Value="#FF1E88E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                             
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkSmartRAM}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <CheckBox x:Name="chkTopMostMonitor" Content="{loc:Tr 'Keep widget window always on top'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="chkTopMostMonitor_Checked" Unchecked="chkTopMostMonitor_Unchecked" Margin="0,0,0,10" />

                    <CheckBox x:Name="chkEnableAutoClean" Content="{loc:Tr 'Enable Automatic Cleaning'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="chkEnableAutoClean_Checked" Unchecked="chkEnableAutoClean_UnChecked" Margin="0,0,0,6"/>
                    <Grid Margin="24,0,0,12" Width="180" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Every:'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Grid.Column="0" Margin="0,0,8,0" />
                        <ComboBox x:Name="cbCleanInterval" Height="28" Style="{DynamicResource ModernComboBoxStyle}" SelectedIndex="0" Grid.Column="1" FontSize="12" SelectionChanged="cbCleanInterval_SelectionChanged">
                            <ComboBoxItem Content="{loc:Tr '1 Minute'}"/>
                            <ComboBoxItem Content="{loc:Tr '5 Minutes'}" />
                            <ComboBoxItem Content="{loc:Tr '10 Minutes'}" />
                            <ComboBoxItem Content="{loc:Tr '15 Minutes'}" />
                            <ComboBoxItem Content="{loc:Tr '30 Minutes'}" />
                            <ComboBoxItem Content="{loc:Tr '1 Hour'}" />
                            <ComboBoxItem Content="{loc:Tr '2 Hours'}" />
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="chkShowNotification" Content="{loc:Tr 'Show notification after cleaning'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="chkShowNotification_Checked" Unchecked="chkShowNotification_UnChecked" Margin="0,0,0,10" />
                    <CheckBox x:Name="chkSkipOnLowBattery" Content="{loc:Tr 'Skip cleaning if battery is below 30%'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="chkSkipOnLowBattery_Checked" Unchecked="chkSkipOnLowBattery_UnChecked" Margin="0,0,0,20" />
                    <CheckBox x:Name="chkStartWithWinCleaner" Content="{loc:Tr 'Start with Win Cleaner'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Checked="chkStartWithWinCleaner_Checked" Unchecked="chkStartWithWinCleaner_UnChecked" Margin="0,0,0,20" />

                    <TextBlock Text="{loc:Tr 'EXTRA CLEANUP'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                    <CheckBox x:Name="chkClearTemp" Content="{loc:Tr 'Clear Windows Temp Files'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Checked="chkClearTemp_Checked" Unchecked="chkClearTemp_Unchecked"/>
                    <CheckBox x:Name="chkClearClipboard" Content="{loc:Tr 'Clear Clipboard Data'}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Checked="chkClearClipboard_Checked" Unchecked="chkClearClipboard_Unchecked"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
