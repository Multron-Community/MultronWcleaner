<Window x:Class="MultronWinCleaner.Configure" Icon="pack://application:,,,/Assets/mwc_utilities.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Configure Turbo Boost Services'}"
        Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackground}">

    <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}">
        <DockPanel>

        
            
            <Grid DockPanel.Dock="Top" Height="36" Background="{DynamicResource TitleBarBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

             
                <TextBlock x:Name="TitleText" Text="{loc:Tr 'Configure Optimization Services'}" Foreground="{DynamicResource TitleBarText}" VerticalAlignment="Center" FontWeight="Bold" Margin="12,0,0,0"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

               
                <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Grid.Column="1" Click="Minimize_Click"
                        ToolTip="{loc:Tr 'Minimize'}"/>

             
                <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Grid.Column="2" Click="Close_Click"
                        ToolTip="{loc:Tr 'Close'}"/>
            </Grid>

          
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
 
                <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" Text="{loc:Tr 'Select the services to pause during optimization:'}" 
                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

               
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <ItemsControl x:Name="ServicesList" Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5,4" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="320" Visibility="{Binding DescriptionVisibility}"/>
                                    </StackPanel>
                                </CheckBox>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

               
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{loc:Tr 'Save'}" MinWidth="80" HorizontalAlignment="Center" Padding="10,2" Margin="5" Click="Save_Click"
                            Background="{DynamicResource ButtonBackground}" 
                            Foreground="{DynamicResource ButtonForeground}"
                            BorderBrush="{DynamicResource ButtonBorder}"
                            Cursor="Hand"/>
                    <Button Content="{loc:Tr 'Cancel'}" MinWidth="80" HorizontalAlignment="Center" Padding="10,2" Margin="5" Click="Cancel_Click"
                            Background="{DynamicResource ButtonBackground}" 
                            Foreground="{DynamicResource ButtonForeground}"
                            BorderBrush="{DynamicResource ButtonBorder}"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
