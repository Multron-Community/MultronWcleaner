<Window xmlns:mwcp="clr-namespace:MultronWinCleaner.Processes" x:Class="MultronWinCleaner.Configure" Icon="pack://application:,,,/Assets/Icons/mwc_optimize.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Configure Turbo Boost Services'}"
        Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border mwcp:RoundedClip.Enabled="True" Background="{DynamicResource WindowBackground}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BevelBorder}">
        <DockPanel>

        
            
            <Grid DockPanel.Dock="Top" Height="52" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/Icons/mwc_optimize.png" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" Text="{loc:Tr 'Configure Optimization Services'}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                </StackPanel>

               
                <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Grid.Column="1" Click="Minimize_Click"
                        ToolTip="{loc:Tr 'Minimize'}"/>

             
                <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Grid.Column="2" Click="Close_Click"
                        ToolTip="{loc:Tr 'Close'}"/>
            </Grid>

          
            <Grid Margin="14,4,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
 
                <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" Text="{loc:Tr 'Select the services to pause during optimization:'}" 
                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,10"/>

               
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <ItemsControl x:Name="ServicesList" Background="Transparent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5,4" VerticalContentAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="320"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="320" Visibility="{Binding DescriptionVisibility}"/>
                                    </StackPanel>
                                </CheckBox>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

               
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="{loc:Tr 'Cancel'}" Height="34" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" Style="{DynamicResource UtilitySecondaryButtonStyle}"/>
                    <Button Content="{loc:Tr 'Save'}" Height="34" MinWidth="96" Click="Save_Click" IsDefault="True" Style="{DynamicResource UtilityPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
