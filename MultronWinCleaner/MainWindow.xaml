                                                            <CheckBox x:Name="SystemFilesRun" Content="{loc:Tr 'Repair during cleaning'}" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{DynamicResource TextPrimary}"/>
