                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Border Panel.ZIndex="2" Background="{DynamicResource PanelBackground}" Visibility="{Binding Visibility, ElementName=Datagridscroll}" IsHitTestVisible="False">
