                                            <TextBlock x:Name="labelShred" Foreground="{DynamicResource ResultSuccessText}" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border x:Name="NoticeArea" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
