                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <ContentPresenter/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.GroupStyle>
                                                            <GroupStyle>
                                                                <GroupStyle.ContainerStyle>
                                                                    <Style TargetType="{x:Type GroupItem}">
