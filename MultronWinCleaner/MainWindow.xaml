                                                            <CheckBox x:Name="ComponentStoreRun" Content="{loc:Tr 'Clean during cleaning'}" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{DynamicResource TextPrimary}"/>
