                                                <DockPanel>
                                                    <Grid Width="36" Height="36" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,14,0">
                                                        <Image Source="pack://application:,,,/Assets/Icons/mwc_dism.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
