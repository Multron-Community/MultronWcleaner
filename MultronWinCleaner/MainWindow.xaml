                                    <Button x:Name="DialogNoButton" Content="{loc:Tr 'No'}" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextPrimary}" Padding="20,8" Margin="0,0,8,0" Click="DialogNoButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="DialogYesButton" Content="{loc:Tr 'Yes'}" Style="{StaticResource ResetButtonStyle}" Padding="20,8" Click="DialogYesButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="DialogOkButton" Content="{loc:Tr 'OK'}" Style="{StaticResource ResetButtonStyle}" Padding="24,8" Click="DialogOkButton_Click" Visibility="Visible"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

