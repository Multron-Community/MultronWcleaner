                                                            <Button x:Name="ShortcutFixButton" Content="{loc:Tr 'Fix Shortcuts'}" Style="{StaticResource ResetButtonStyle}"
                                                                    Padding="14,6" FontSize="12" Click="ShortcutFixButton_Click"/>
                                                            <Button x:Name="ShortcutCancelButton" Content="✕" ToolTip="{loc:Tr 'Skip the shortcut check'}" Style="{StaticResource ResetButtonStyle}"
                                                                    Width="32" Height="32" Padding="0" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                                    Visibility="Collapsed" Click="ScanStepCancelButton_Click"/>
                                                        </StackPanel>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:Tr 'Shortcuts'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock x:Name="ShortcutResultsStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ItemsControl x:Name="ShortcutResultsList" Margin="42,10,0,0" Visibility="Collapsed">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SecondaryPanelBackground}" CornerRadius="6" Padding="10,6" Margin="0,3">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                                                            <TextBlock Text="{Binding Location}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding TargetPath}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                        <TextBlock Text="{Binding Action}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="SecurityResultsPanel" Visibility="Collapsed" Margin="0,0,0,20" Padding="16,12"
                                                    CornerRadius="10" BorderThickness="1" BorderBrush="#661E88E5" Background="#141E88E5">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Grid Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <Ellipse x:Name="SecurityResultsIcon" Fill="#FF1E88E5"/>
                                                            <TextBlock Text="🛡" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button x:Name="SecurityStatusButton" Content="{loc:Tr 'Show Status'}" Style="{StaticResource ResetButtonStyle}" Visibility="Collapsed"
                                                                    Padding="14,6" FontSize="12" Margin="0,0,8,0" Click="SecurityStatusButton_Click"/>
                                                            <Button x:Name="SecurityResultsToggle" Content="{loc:Tr 'Show Issues'}" Style="{StaticResource ResetButtonStyle}"
                                                                    Padding="14,6" FontSize="12" Margin="0,0,8,0" Click="SecurityResultsToggle_Click"/>
                                                            <Button x:Name="SecurityFixButton" Content="{loc:Tr 'Fix Selected'}" Style="{StaticResource ResetButtonStyle}"
                                                                    Padding="14,6" FontSize="12" Click="SecurityFixButton_Click"/>
                                                            <Button x:Name="SecurityCancelButton" Content="✕" ToolTip="{loc:Tr 'Skip the security check'}" Style="{StaticResource ResetButtonStyle}"
                                                                    Width="32" Height="32" Padding="0" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                                    Visibility="Collapsed" Click="ScanStepCancelButton_Click"/>
                                                        </StackPanel>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:Tr 'Security Settings'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock x:Name="SecurityResultsStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ItemsControl x:Name="SecurityResultsList" Margin="42,10,0,0" Visibility="Collapsed">
                                                        <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SecondaryPanelBackground}" CornerRadius="6" Padding="10,6" Margin="0,3">
                                                            <DockPanel>
                                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,10,0"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanFix}"
                                                                          ToolTip="{loc:Tr 'Fix this setting'}"/>
                                                                <Button DockPanel.Dock="Right" Content="{loc:Tr 'Ignore'}" Tag="{Binding}" Click="IgnoreSecurityIssue_Click"
                                                                        Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray"
                                                                        Foreground="{DynamicResource TextPrimary}" Padding="10,3" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                        ToolTip="{loc:Tr 'Do not show or report this warning again'}"/>
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <Border Background="{Binding SeverityColor}" CornerRadius="4" Padding="6,1" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0">
                                                                            <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding DetailsText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding ActionText}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="DuplicateResultsPanel" Visibility="Collapsed" Margin="0,0,0,20" Padding="16,12"
                                                    CornerRadius="10" BorderThickness="1" BorderBrush="#66FF9800" Background="#14FF9800">
                                                <DockPanel>
                                                    <Grid Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Ellipse x:Name="DuplicateResultsIcon" Fill="#FFFF9800"/>
                                                        <TextBlock Text="⧉" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Button x:Name="DuplicateCancelButton" DockPanel.Dock="Right" Content="✕" ToolTip="{loc:Tr 'Cancel the duplicate file search'}" Style="{StaticResource ResetButtonStyle}"
                                                            Width="32" Height="32" Padding="0" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                            Visibility="Collapsed" Click="DuplicateCancelButton_Click"/>
                                                    <Button x:Name="DuplicateResultsButton" DockPanel.Dock="Right" Content="{loc:Tr 'Show Files'}" Style="{StaticResource ResetButtonStyle}"
                                                            Padding="14,6" FontSize="12" VerticalAlignment="Center" Click="DuplicateResultsButton_Click"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Tr 'Duplicate Files'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock x:Name="DuplicateResultsStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <Border x:Name="MalwareResultsPanel" Visibility="Collapsed" Margin="0,0,0,20" Padding="16,12"
                                                    CornerRadius="10" BorderThickness="1" BorderBrush="#33888888" Background="#0C1E88E5">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Grid Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <Ellipse x:Name="MalwareResultsIcon" Fill="#FF1E88E5"/>
                                                            <Path Data="M12,1 L3,5 V11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 V5 Z"
                                                                  Fill="White" Stretch="Uniform" Width="13" Height="14"/>
                                                        </Grid>
                                                        <Button x:Name="MalwareCancelButton" DockPanel.Dock="Right" Content="✕" ToolTip="{loc:Tr 'Cancel the malware scan'}" Style="{StaticResource ResetButtonStyle}"
                                                                Width="32" Height="32" Padding="0" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                                Visibility="Collapsed" Click="MalwareCancelButton_Click"/>
                                                        <Button x:Name="MalwareResultsButton" DockPanel.Dock="Right" Content="{loc:Tr 'Open Results'}" Style="{StaticResource ResetButtonStyle}"
                                                                Padding="14,6" FontSize="12" VerticalAlignment="Center" Click="MalwareResultsButton_Click"/>
                                                        <Button x:Name="MalwareMrtResultsButton" DockPanel.Dock="Right" Content="{loc:Tr 'MRT Results'}" Style="{StaticResource ResetButtonStyle}"
                                                                Padding="14,6" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                                ToolTip="{loc:Tr 'Shows what Microsoft MRT found, with its full report from mrt.log.'}" Click="MrtResultsButton_Click"/>
                                                        <Button x:Name="MalwareMrtRemoveButton" DockPanel.Dock="Right" Content="{loc:Tr 'Remove with MRT'}" Style="{StaticResource ResetButtonStyle}"
                                                                Background="#FFDC3545" Padding="14,6" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                                ToolTip="{loc:Tr 'Runs Microsoft MRT again and lets it remove the malicious software it finds.'}" Click="MrtRemoveButton_Click"/>
                                                        <ComboBox x:Name="MalwarePanelModeBox" Visibility="Collapsed" DockPanel.Dock="Right" Width="130" Height="32" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                  Style="{StaticResource PanelComboBoxStyle}" ToolTip="{loc:Tr 'Scan type used for the next malware scan'}" SelectionChanged="MalwarePanelModeBox_SelectionChanged">
                                                            <ComboBoxItem Content="{loc:Tr 'Quick Scan'}"/>
                                                            <ComboBoxItem Content="{loc:Tr 'Full Scan'}"/>
                                                            <ComboBoxItem Content="{loc:Tr 'Custom Scan'}"/>
                                                        </ComboBox>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="MalwareResultsTitle" Text="{loc:Tr 'Multron Malware Scan Cloud'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock x:Name="MalwareResultsStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <ItemsControl x:Name="MalwareThreatsList" Margin="42,10,0,0" Visibility="Collapsed" MaxHeight="320"
                                                                  VirtualizingPanel.IsVirtualizing="True"
                                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                                  VirtualizingPanel.CacheLength="2,2"
                                                                  VirtualizingPanel.CacheLengthUnit="Page"
                                                                  ScrollViewer.CanContentScroll="True"
                                                                  PreviewMouseWheel="MalwareThreatsList_PreviewMouseWheel">
                                                        <ItemsControl.Template>
                                                            <ControlTemplate TargetType="ItemsControl">
                                                                <ScrollViewer x:Name="ThreatsScroll" CanContentScroll="True" Focusable="False"
                                                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                                                    <ItemsPresenter/>
                                                                </ScrollViewer>
                                                            </ControlTemplate>
                                                        </ItemsControl.Template>
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SecondaryPanelBackground}" CornerRadius="6" Padding="10,6" Margin="0,3">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border Background="#261E88E5" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Source}" FontSize="10.5" FontWeight="Bold" Foreground="#FF1E88E5"/>
                                                                            </Border>
                                                                            <TextBlock Text="{Binding VerdictText}" FontWeight="Bold" FontSize="12" Foreground="#FFDC3545" Margin="0,0,8,0"/>
                                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                                                            <TextBlock Text="{Binding ThreatName}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                                                <Label Content="{loc:Tr 'Search for directory:'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextForeground}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Grid Margin="0,0,16,0">
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" />
                                                </Grid>
                                                <Button Content="{loc:Tr 'Select All'}" Click="SelectAll_AllGroups_Click" Style="{StaticResource ModernButtonStyle}" Background="#FF1E88E5" Foreground="White" Margin="0,0,8,0" />
                                                <Button Content="{loc:Tr 'Unselect All'}" Click="UnselectAll_AllGroups_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" />
                                            </StackPanel>

                                            <DataGrid Name="dataGridGroups" ItemsSource="{Binding Groups}" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsReadOnly="True" HeadersVisibility="Column" RowDetailsVisibilityMode="Visible" AutoGenerateColumns="False" Foreground="{DynamicResource TextForeground}">
                                                <DataGrid.Resources>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </Style>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                                    </Style>
                                                </DataGrid.Resources>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{loc:Tr 'Path'}" Binding="{Binding Path}" Width="0" Visibility="Collapsed" />
                                                </DataGrid.Columns>
                                                <DataGrid.RowDetailsTemplate>
                                                    <DataTemplate>
                                                        <Expander IsExpanded="False" Background="Transparent" Foreground="{DynamicResource TextForeground}" Header="{Binding ExpanderHeader}">
                                                            <StackPanel Margin="16,8">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                    <Button Content="{loc:Tr 'Select All'}" Click="SelectAll_Click" Tag="{Binding}" Style="{StaticResource ModernButtonStyle}" Background="#FF1E88E5" Foreground="White" Margin="0,0,8,0" Padding="12,6"/>
                                                                    <Button Content="{loc:Tr 'Unselect All'}" Click="UnselectAll_Click" Tag="{Binding}" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Padding="12,6"/>
                                                                </StackPanel>
                                                                <ScrollViewer Name="ListBoxScroll" Height="180" Background="Transparent" ScrollChanged="FilesListBox_ScrollChanged">
                                                                    <ListBox ItemsSource="{Binding Files}" Background="Transparent" BorderThickness="0">
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,4" Foreground="{DynamicResource TextForeground}" Checked="CheckBox2_Checked" Unchecked="CheckBox2_Unchecked">
                                                                                    <CheckBox.ContextMenu>
                                                                                        <ContextMenu>
                                                                                            <MenuItem Header="{loc:Tr 'Open file location'}" Click="OpenFileLocation_Click"/>
                                                                                            <MenuItem Header="{loc:Tr 'Copy path'}" Click="CopyPath_Click"/>
                                                                                            <MenuItem Header="{loc:Tr 'Always skip this file (add to Exceptions)'}" Click="AddToExceptions_Click"/>
                                                                                        </ContextMenu>
                                                                                    </CheckBox.ContextMenu>
                                                                                </CheckBox>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </DataGrid.RowDetailsTemplate>
                                            </DataGrid>
                                        </StackPanel>
                                    </ScrollViewer>
 
                                    <ScrollViewer x:Name="ScrollViewerDirectories" Panel.ZIndex="1" Background="{DynamicResource PanelBackground}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="wrapPanelDirectories" Orientation="Vertical" Margin="10" />
                                    </ScrollViewer>
                                    
                                    <Grid x:Name="ScrollViewerDetectedFiles" Panel.ZIndex="0" Visibility="Visible" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <WrapPanel Grid.Row="0" Margin="0,0,0,20">
                                            <Button x:Name="SlctAll" Content="{loc:Tr 'Select All'}" Click="SelectAll_wpanel_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#FF1E88E5" Foreground="White" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="UnScl" Content="{loc:Tr 'Unselect All'}" Click="UnselectAll_wpanel_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="SaveSettings" Content="{loc:Tr 'Save Selections'}" Click="SaveSettings_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#FF28A745" Foreground="White" Margin="0,0,10,10" Padding="16,10" ToolTip="{loc:Tr 'Saves your choices to selections.txt. They are kept when the database is updated.'}" />
                                            <Button x:Name="ApplySelections" Content="{loc:Tr 'Write Selections to Database'}" Click="ApplySelectionsToDatabase_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" ToolTip="{loc:Tr 'Optional: writes your saved choices into database.txt. They are lost when a newer database is downloaded.'}" />
                                            <Button x:Name="ResetSelections" Content="{loc:Tr 'Reset Selections'}" Click="ResetSelections_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" BorderThickness="1" BorderBrush="#FFDC3545" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" ToolTip="{loc:Tr 'Deletes selections.txt so every entry goes back to its default from the database.'}" />
                                            <Button x:Name="ReloadDb" Content="{loc:Tr 'Reload Database'}" Click="ReloadDatabase_Click" Style="{StaticResource ModernButtonStyle}" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextForeground}" Margin="0,0,10,10" Padding="16,10" />
                                            <Button x:Name="UpdateDb" Content="{loc:Tr 'Update Database'}" Click="UpdateDatabase_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#FF1E88E5" Foreground="White" Margin="0,0,10,10" Padding="16,10" ToolTip="{loc:Tr 'Downloads the newest database from GitHub and loads it. In offline mode the GitHub download page opens instead.'}" />

                                            <Border Height="36" Width="240" Margin="0,0,0,10" CornerRadius="18" VerticalAlignment="Center"
                                                    Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="0.85">
                                                <Grid Margin="12,0,6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.55" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock x:Name="LibrarySearchHint" Grid.Column="1" Text="{loc:Tr 'Search apps or paths'}" Margin="8,0,0,0" FontSize="12.5" Opacity="0.45"
                                                               VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBox x:Name="LibrarySearchBox" Grid.Column="1" Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                                             TextChanged="LibrarySearchBox_TextChanged" KeyDown="LibrarySearchBox_KeyDown"
                                                             ToolTip="{loc:Tr 'Shows only the entries whose app name or path contains this text. Esc clears it.'}"/>
                                                    <Button x:Name="LibrarySearchClear" Grid.Column="2" Content="✕" Width="22" Height="22" Padding="0" FontSize="10"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextPrimary}" Click="LibrarySearchClear_Click" ToolTip="{loc:Tr 'Clear'}"/>
                                                </Grid>
                                            </Border>
                                        </WrapPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                                            <StackPanel x:Name="wrapPanel1" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                        </ScrollViewer>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
