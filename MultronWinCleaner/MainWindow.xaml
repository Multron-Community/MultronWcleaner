                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Tr 'Component Store Health (DISM)'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock x:Name="ComponentHealthStatus" Text="" Style="{StaticResource CardStatusText}"/>
                                                        <WrapPanel Orientation="Horizontal">
                                                            <CheckBox x:Name="ComponentHealthRun" Content="{loc:Tr 'Repair during cleaning'}" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" Foreground="{DynamicResource TextPrimary}"/>
                                                        </WrapPanel>
