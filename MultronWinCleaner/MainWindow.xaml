                                                        <TextBlock DockPanel.Dock="Left" Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="labelDiskPercent" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
