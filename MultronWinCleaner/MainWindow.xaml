                                                                <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentText}"/>
                                                                <Setter TargetName="Pill" Property="Width" Value="56"/>
                                                                <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
