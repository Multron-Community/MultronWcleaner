                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="860" MaxHeight="720" Margin="50"
                                                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
