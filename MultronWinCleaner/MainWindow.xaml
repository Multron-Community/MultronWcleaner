                                                            <Border x:Name="DiskUsedBar" CornerRadius="3" Background="#FF1E88E5"/>
                                                        </Grid>
                                                    </Grid>
                                                    <TextBlock x:Name="labelDiskSize" Text="{loc:Tr 'Size on disk: 0 Byte'}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="labelStartupClean" Foreground="{DynamicResource ResultSuccessText}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
