                                    </Border>
                                    <TextBlock x:Name="DialogTitleText" Text="{loc:Tr 'Warning'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="DialogMessageText" Text="" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"/>
