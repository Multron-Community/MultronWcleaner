                                                    </DockPanel>
                                                    <Grid Height="6" Margin="0,7,0,6">
                                                        <Border CornerRadius="3" Background="#26808080"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="DiskUsedColumn" Width="0*"/>
                                                                <ColumnDefinition x:Name="DiskFreeColumn" Width="1*"/>
