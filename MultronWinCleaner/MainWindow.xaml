                                        <StackPanel x:Name="wrapPanelDirectories" Orientation="Vertical" Margin="10" />
                                    </ScrollViewer>

                                    <Border x:Name="MalwareTopNotice" Panel.ZIndex="5" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,14" Padding="14,9" CornerRadius="10" Background="#FFC62F3B">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.4"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="430">
                                                <TextBlock x:Name="MalwareTopNoticeTitle" Text="{loc:Tr 'Malware scan finished: threats found!'}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="MalwareTopNoticeDetail" Visibility="Collapsed" FontSize="12" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="MalwareTopNoticeButton" Grid.Column="2" Content="{loc:Tr 'Scroll to top'}" Click="MalwareTopNotice_Top_Click" Style="{StaticResource ModernButtonStyle}" Background="White" Foreground="#FFC62F3B" Padding="12,5" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="✕" Click="MalwareTopNotice_Close_Click" Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="White" Padding="8,5" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" ToolTip="{loc:Tr 'Close'}"/>
                                        </Grid>
                                    </Border>
                                    
                                    <Grid x:Name="ScrollViewerDetectedFiles" Panel.ZIndex="0" Visibility="Visible" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                                            <Button x:Name="SlctAll" Content="{loc:Tr 'Select All'}" Click="SelectAll_wpanel_Click" Style="{DynamicResource UtilityPrimaryButtonStyle}" Height="36" Margin="0,0,10,10" Padding="16,0" />
                                            <Button x:Name="UnScl" Content="{loc:Tr 'Unselect All'}" Click="UnselectAll_wpanel_Click" Style="{DynamicResource UtilityNeutralButtonStyle}" Height="36" Margin="0,0,10,10" Padding="16,0" />
                                            <ToggleButton x:Name="SelectionsMenuToggle" Content="{loc:Tr 'Selections'}">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolbarDropDownStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen, ElementName=SelectionsPopup}" Value="True">
                                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Popup x:Name="SelectionsPopup" PlacementTarget="{Binding ElementName=SelectionsMenuToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                                   PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=SelectionsMenuToggle, Mode=TwoWay}">
                                                <Border Style="{StaticResource ToolbarMenuPanelStyle}" ButtonBase.Click="ToolbarMenu_Click">
                                                    <StackPanel>
                                                        <Button x:Name="SaveSettings" Content="{loc:Tr 'Save Selections'}" Tag="&#xE74E;" Click="SaveSettings_Click" Style="{StaticResource ToolbarMenuButtonStyle}" ToolTip="{loc:Tr 'Saves your choices to selections.txt. They are kept when the database is updated.'}" />
                                                        <Button x:Name="ApplySelections" Content="{loc:Tr 'Write Selections to Database'}" Tag="&#xE8F1;" Click="ApplySelectionsToDatabase_Click" Style="{StaticResource ToolbarMenuButtonStyle}" ToolTip="{loc:Tr 'Optional: writes your saved choices into database.txt. They are lost when a newer database is downloaded.'}" />
                                                        <Button x:Name="ResetSelections" Content="{loc:Tr 'Reset Selections'}" Tag="&#xE72C;" Click="ResetSelections_Click" Style="{StaticResource ToolbarMenuButtonStyle}" Foreground="#FFE5534B" ToolTip="{loc:Tr 'Deletes selections.txt so every entry goes back to its default from the database.'}" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                            <ToggleButton x:Name="DatabaseMenuToggle" Content="{loc:Tr 'Database'}">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolbarDropDownStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen, ElementName=DatabasePopup}" Value="True">
                                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Popup x:Name="DatabasePopup" PlacementTarget="{Binding ElementName=DatabaseMenuToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="DatabasePopup_Opened" Closed="DatabasePopup_Closed"
                                                   PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=DatabaseMenuToggle, Mode=TwoWay}">
                                                <Border Style="{StaticResource ToolbarMenuPanelStyle}" ButtonBase.Click="ToolbarMenu_Click">
                                                    <StackPanel>
                                                        <Button x:Name="ReloadDb" Content="{loc:Tr 'Reload Database'}" Tag="&#xE72C;" Click="ReloadDatabase_Click" Style="{StaticResource ToolbarMenuButtonStyle}" />
                                                        <Button x:Name="UpdateDb" Content="{loc:Tr 'Update Database'}" Tag="&#xE896;" Click="UpdateDatabase_Click" Style="{StaticResource ToolbarMenuButtonStyle}" ToolTip="{loc:Tr 'Downloads the newest database from GitHub and loads it. In offline mode the GitHub download page opens instead.'}" />
                                                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="6,6"/>
                                                        <TextBlock Text="{loc:Tr 'Additional databases'}" FontSize="11.5" FontWeight="SemiBold" Opacity="0.65" Margin="10,2,10,4" Foreground="{DynamicResource TextPrimary}"/>
                                                        <StackPanel x:Name="ExtraDatabasesPanel"/>
                                                        <TextBlock x:Name="NoExtraDatabasesText" Text="{loc:Tr 'None yet. Add one from a file or an internet address.'}"
                                                                   TextWrapping="Wrap" MaxWidth="250" HorizontalAlignment="Left" FontSize="12" Opacity="0.6" Margin="10,2,10,6" Foreground="{DynamicResource TextPrimary}"/>
                                                        <Button Content="{loc:Tr 'Add from file...'}" Tag="&#xE8E5;" Click="AddDatabaseFile_Click" Style="{StaticResource ToolbarMenuButtonStyle}"
                                                                ToolTip="{loc:Tr 'Choose one or more .txt databases. They are copied to the Databases folder next to the app and turned on.'}"/>
                                                        <Button Content="{loc:Tr 'Add from internet address...'}" Tag="&#xE774;" Click="AddDatabaseUrl_Click" Style="{StaticResource ToolbarMenuButtonStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>

                                            <Border x:Name="LibrarySearchPanel" Height="36" MinWidth="150" Margin="0,0,0,10" CornerRadius="18" VerticalAlignment="Top"
                                                    Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="0.85">
                                                <Grid Margin="12,0,6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.55" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock x:Name="LibrarySearchHint" Grid.Column="1" Text="{loc:Tr 'Search apps or paths'}" Margin="8,0,0,0" FontSize="12.5" Opacity="0.45"
                                                               VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBox x:Name="LibrarySearchBox" Grid.Column="1" Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                                             TextChanged="LibrarySearchBox_TextChanged" KeyDown="LibrarySearchBox_KeyDown"
                                                             ToolTip="{loc:Tr 'Shows only the entries whose app name or path contains this text. Esc clears it.'}"/>
                                                    <Button x:Name="LibrarySearchClear" Grid.Column="2" Content="✕" Width="22" Height="22" Padding="0" FontSize="10"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource TextPrimary}" Click="LibrarySearchClear_Click" ToolTip="{loc:Tr 'Clear'}"/>
                                                </Grid>
                                            </Border>
                                        </DockPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                                            <StackPanel x:Name="wrapPanel1" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                        </ScrollViewer>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
