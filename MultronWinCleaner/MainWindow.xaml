                                <Grid x:Name="Panel">

                                
                                    <Grid x:Name="LockedFilesWindowOverlay" Panel.ZIndex="50" Visibility="Collapsed" Grid.ColumnSpan="10" Grid.RowSpan="10" Margin="-30">
