                                                                                                    </Border>
                                                                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                                </DockPanel>
                                                                                            </Expander.Header>
                                                                                            <ItemsPresenter Margin="8,0,8,10"/>
                                                                                        </Expander>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </GroupStyle.ContainerStyle>
                                                            </GroupStyle>
                                                        </ListBox.GroupStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource SecondaryPanelBackground}" CornerRadius="8" Padding="12,9" Margin="0,3">
