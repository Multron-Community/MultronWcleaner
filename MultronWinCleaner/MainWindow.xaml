                                </Grid>
                            </Border>
                        </Border>
 
                        <Border x:Name="MainRightPanel" Grid.Column="1" Panel.ZIndex="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BevelBorder}" BorderThickness="1" CornerRadius="16" Margin="20,0,0,0" Effect="{StaticResource DropShadowSoft}">
