                                                <ScrollViewer Grid.Row="2" x:Name="MainScrollViewer" Margin="20,8,12,8" Padding="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="MainScrollViewer_ScrollChanged">
