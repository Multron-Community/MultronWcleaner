                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="ResultIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ResultSuccessText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="ResultTitle" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ResultAmount" Foreground="{DynamicResource ResultSuccessText}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="ResultAmountCaption" Foreground="{DynamicResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    <StackPanel x:Name="ResultDetails" Margin="0,10,0,0"/>
                                                    <TextBlock x:Name="ResultTime" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="ScanLivePanel" Visibility="Collapsed" Margin="0,0,0,6" Padding="12,10" CornerRadius="12"
