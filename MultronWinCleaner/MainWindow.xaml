                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4DFFFFFF" Offset="0"/>
                                        <GradientStop Color="#0DFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#40000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse IsHitTestVisible="False" Width="104" Height="64" VerticalAlignment="Top" Margin="0,5,0,0">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#30FFFFFF" Offset="0"/>
                                        <GradientStop Color="#0DFFFFFF" Offset="0.6"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="OrbRim" IsHitTestVisible="False" StrokeThickness="2.5" Margin="2" Opacity="0"/>
