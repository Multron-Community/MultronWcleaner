                                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                                    <Border Background="#0D808080" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
