                                                    <TextBlock x:Name="ScanLiveHeader" Text="{loc:Tr 'Scanning'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="ScanLiveTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock x:Name="ScanLiveDetail" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="RestartRequiredPanel" Visibility="Collapsed" Margin="0,2,0,6" Padding="12,8" CornerRadius="10"
                                                    Background="{DynamicResource WarningTint}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
