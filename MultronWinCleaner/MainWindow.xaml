                                            <TextBlock x:Name="LastLogText" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="6,-4,6,10"/>
                                            <Border x:Name="ResultCard" Visibility="Collapsed" Margin="0,0,0,6" Padding="14,12" CornerRadius="12"
                                                    Background="#1A2EB872" BorderBrush="#802EB872" BorderThickness="1">
