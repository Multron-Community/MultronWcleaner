<Window x:Class="MultronWinCleaner.ToolSettingsWindow" Icon="pack://application:,,,/Assets/mwc_utilities.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Settings'}"
        Width="900" Height="600" MinWidth="480" MinHeight="300"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">

    <Border Background="{DynamicResource WindowBackground}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" CornerRadius="12,12,0,0" MouseDown="TopBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF1E88E5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" HorizontalAlignment="Right" Margin="0,0,10,0"
                            Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,18,20,20">
                <ContentPresenter x:Name="ContentHost"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
