<Window
    x:Class="MultronWinCleaner.ScanLogsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:MultronWinCleaner"
    Title="{loc:Tr 'Scan Logs'}"
    Height="620" Width="1080"
    MinHeight="400" MinWidth="760"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    AllowsTransparency="True"
    WindowStartupLocation="CenterOwner"
    Icon="pack://application:,,,/Assets/mwc_utilities.ico"
    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
    Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MalwareScanStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0,0,0,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseDown="TopBar_MouseDown" Margin="20,14,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#FF1E88E5" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Tr 'Scan Logs'}" FontSize="19" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Text="" FontSize="13" Margin="10,2,0,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Click="MinimizeButton_Click" ToolTip="{loc:Tr 'Minimize'}" Margin="0,0,4,0"/>
                <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="6*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="LogsDataGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              ColumnHeaderStyle="{StaticResource ResultsHeaderStyle}"
                              CellStyle="{StaticResource ResultsCellStyle}"
                              RowStyle="{StaticResource ResultsRowStyle}"
                              EnableRowVirtualization="True" SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                              SelectionChanged="LogsDataGrid_SelectionChanged" MouseDoubleClick="OpenLog_Click">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Tr 'Open in Notepad'}" Click="OpenLog_Click"/>
                                <MenuItem Header="{loc:Tr 'Open Logs Folder'}" Click="OpenFolder_Click"/>
                                <MenuItem Header="{loc:Tr 'Export Log'}" Click="ExportLog_Click"/>
                                <Separator/>
                                <MenuItem Header="{loc:Tr 'Delete'}" Click="Delete_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr 'Date'}" Binding="{Binding FormattedDate}" Width="140" SortMemberPath="Date"/>
                            <DataGridTextColumn Header="{loc:Tr 'Type'}" Binding="{Binding Kind}" Width="105"/>
                            <DataGridTextColumn Header="{loc:Tr 'Result'}" Binding="{Binding Result}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Result}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{DynamicResource TextSecondary}"
                                   Opacity="0.45" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'No scan logs yet.'}" Margin="0,10,0,0" Style="{StaticResource HintStyle}" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Tr 'Refresh'}" Click="Refresh_Click" Style="{StaticResource SoftButtonStyle}" Margin="0,0,8,6"/>
                        <Button Content="{loc:Tr 'Delete Selected'}" Click="Delete_Click" Style="{StaticResource DangerSoftButtonStyle}" Margin="0,0,8,6"/>
                        <Button Content="{loc:Tr 'Delete All'}" Click="DeleteAll_Click" Style="{StaticResource DangerSoftButtonStyle}" Margin="0,0,8,6"/>
                        <Button Content="{loc:Tr 'Export All (ZIP)'}" Click="ExportAll_Click" Style="{StaticResource SoftButtonStyle}" Margin="0,0,8,6"
                                ToolTip="{loc:Tr 'Saves all scan logs in one ZIP file.'}"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource TextBoxBackground}">
                        <TextBox x:Name="LogViewerTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}" Padding="10,8" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Tr 'Open in Notepad'}" Click="OpenLog_Click" Style="{StaticResource SoftButtonStyle}" Margin="0,0,8,6"/>
                        <Button Content="{loc:Tr 'Copy Log'}" Click="CopyLog_Click" Style="{StaticResource SoftButtonStyle}" Margin="0,0,8,6"/>
                        <Button Content="{loc:Tr 'Export Log'}" Click="ExportLog_Click" Style="{StaticResource SoftButtonStyle}" Margin="0,0,8,6"
                                ToolTip="{loc:Tr 'Saves the selected log as a text file.'}"/>
                        <Button Content="{loc:Tr 'Open Logs Folder'}" Click="OpenFolder_Click" Style="{StaticResource SoftButtonStyle}" Margin="0,0,8,6"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
