<Window
    x:Class="MultronWinCleaner.ThreatsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:MultronWinCleaner"
    Title="{loc:Tr 'Threats found'}"
    Height="460" Width="860"
    MinHeight="300" MinWidth="560"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    AllowsTransparency="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBackground}"
    FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MalwareScanStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0,0,0,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseDown="TopBar_MouseDown" Margin="20,14,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr 'Threats found'}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource CloseWindowButtonStyle}" Click="Close_Click" ToolTip="{loc:Tr 'Close'}" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="20,0,20,0" Padding="14,10">
            <Grid>
                <DataGrid x:Name="ThreatsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          ColumnHeaderStyle="{StaticResource ResultsHeaderStyle}"
                          CellStyle="{StaticResource ResultsCellStyle}"
                          RowStyle="{StaticResource ResultsRowStyle}"
                          EnableRowVirtualization="True" SelectionMode="Single" IsReadOnly="True"
                          MouseDoubleClick="OpenLocation_Click">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Tr 'Open File Location'}" Click="OpenLocation_Click"/>
                            <MenuItem Header="{loc:Tr 'Copy File Path'}" Click="CopyPath_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Tr 'Status'}" Width="120" SortMemberPath="Verdict">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFDC3545"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="suspicious">
                                                        <Setter Property="Foreground" Value="#FFFF9800"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Tr 'File Name'}" Binding="{Binding FileName}" Width="170"/>
                        <DataGridTextColumn Header="{loc:Tr 'Threat / Detail'}" Binding="{Binding Threat}" Width="230"/>
                        <DataGridTextColumn Header="{loc:Tr 'Size'}" Binding="{Binding FormattedSize}" Width="80" SortMemberPath="Size"/>
                        <DataGridTextColumn Header="{loc:Tr 'Path'}" Binding="{Binding FilePath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="{loc:Tr 'No threats found so far.'}" Style="{StaticResource HintStyle}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
