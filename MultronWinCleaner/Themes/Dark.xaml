        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlEdge}" IsHitTestVisible="False"/>
                        <Grid Margin="1" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="7,7,0,0" Background="{DynamicResource ControlGloss}"/>
                        </Grid>
                        <Border x:Name="overlay" CornerRadius="8" Background="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="overlay" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="overlay" Property="Background" Value="#24000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
 

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
        <Setter Property="Background" Value="#FFC42B1C"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
 
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#555"/>
    </Style>
    
    <SolidColorBrush x:Key="ButtonDangerBackground" Color="#FFB61423"/>
    <SolidColorBrush x:Key="DangerButtonHoverBackground" Color="#FF911820"/>
    <SolidColorBrush x:Key="DangerButtonPressedBackground" Color="#FF6B0F18"/>

    <SolidColorBrush x:Key="NotifyCleanedAmountForeground" Color="#5CD65C"/>
    <SolidColorBrush x:Key="DangerButtonForeground" Color="White"/>
 
    <SolidColorBrush x:Key="ListBoxBackground" Color="#FF252525"/>
    <SolidColorBrush x:Key="ListBoxForeground" Color="#FFE0E0E0"/>

  
</ResourceDictionary>
