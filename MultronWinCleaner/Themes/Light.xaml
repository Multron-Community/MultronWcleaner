    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#FFC42B1C"/>
    </Style>

    

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="#444"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#CCC"/>
    </Style>
 

    <SolidColorBrush x:Key="ButtonDangerBackground" Color="#FFB61423"/>
    <SolidColorBrush x:Key="DangerButtonHoverBackground" Color="#FF9E1221"/>
    <SolidColorBrush x:Key="DangerButtonPressedBackground" Color="#FF7A0E17"/>

  
    <SolidColorBrush x:Key="DangerButtonForeground" Color="White"/>



    <SolidColorBrush x:Key="NotifyCleanedAmountForeground" Color="#5CD65C"/>
    <SolidColorBrush x:Key="ListBoxBackground" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ListBoxForeground" Color="#FF222222"/>
</ResourceDictionary>
