<Window x:Class="MultronWinCleaner.NewStartupItemDetected" Icon="pack://application:,,,/Assets/Icons/mwc_startup.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'New Startup Item Detected'}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="Segoe UI Variable">

    <Window.Resources>
      
        <DropShadowEffect x:Key="DropShadowSoft" Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.30" />
 
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <Grid>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlEdge}" IsHitTestVisible="False"/>
                                <Grid Margin="1" IsHitTestVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="7,7,0,0" Background="{DynamicResource ControlGloss}"/>
                                </Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="0.5" CenterY="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FFC2570A" />
            <Setter Property="Foreground" Value="White" />
          
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFD0620C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFA84B08" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
 
    <Border Margin="20" Background="{DynamicResource PanelBackground}" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Effect="{StaticResource DropShadowSoft}">
        <Border Background="#10000000" CornerRadius="16" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

          
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource WarningTint}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource WarningText}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{loc:Tr 'New Startup Item Detected!'}" TextWrapping="Wrap" MaxWidth="340" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
 
                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                    <TextBlock Text="{loc:Tr 'A new application has been added to your system startup sequence. You can manage or disable it below.'}" 
                               FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>
 
                    <Border Background="{DynamicResource WarningTint}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="4,1,1,1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="ItemNameText" Text="StartupAppName.exe" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ItemPathText" Text="C:\Program Files\Example\StartupApp.exe" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
 
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{loc:Tr 'Ignore'}" Style="{StaticResource ModernButtonStyle}" MinWidth="110"
                            Background="Transparent" BorderThickness="1" BorderBrush="Gray" Foreground="{DynamicResource TextPrimary}" 
                            Padding="0,12" Click="DisableButton_Click"/>

                    <Button Grid.Column="2" Content="{loc:Tr 'Open Startup Manager'}" Style="{StaticResource WarningButtonStyle}" 
                            Padding="0,12" Click="AllowButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
