<Window x:Class="MultronWinCleaner.AddStartup" Icon="pack://application:,,,/Assets/mwc_utilities.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Add Startup Application'}" Height="280" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Border Background="{DynamicResource PanelBackground}" Height="40" VerticalAlignment="Top">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Tr 'Add Startup Application'}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Grid.Column="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,8,0" Grid.Column="1">
                    <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>


        <Grid Margin="14,48,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{loc:Tr 'Application Name'}" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="txtName" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,0,-9"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="{loc:Tr 'Executable Path'}" Style="{StaticResource FieldLabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtPath" Style="{StaticResource FieldTextBoxStyle}" Grid.Column="0" Margin="0,0,0,-9"/>
                    <Button
                            Grid.Column="1" MinWidth="72" HorizontalAlignment="Center" Height="34"
                            Margin="6,0,0,0" Cursor="Hand"
                            Click="Browse_Click"
                            Style="{StaticResource RoundedButtonStyle}"><TextBlock Text="{loc:Tr 'Browse...'}" Margin="10,0"/></Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="{loc:Tr 'Startup Method'}" Style="{StaticResource FieldLabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="rbRegistry"
                                 Content="{loc:Tr 'Registry'}"
                                 IsChecked="True"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontSize="13"
                                 Margin="0,0,16,0"
                                 VerticalAlignment="Center" Checked="rbRegistry_Checked"/>
                    <RadioButton x:Name="rbTaskScheduler"
                                 Content="{loc:Tr 'Task Scheduler'}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontSize="13" Margin="0,0,16,0"
                                 VerticalAlignment="Center" Checked="rbTaskScheduler_Checked"/>
                    <RadioButton x:Name="rbWinLogon"
                         Content="Userunit WinLogon"
                         Foreground="{DynamicResource TextPrimary}"
                         FontSize="13" VerticalAlignment="Center" Checked="rbWinLogon_Checked"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="80" HorizontalAlignment="Center" Height="34" Margin="0,0,8,0"
                        Cursor="Hand" Click="CloseButton_Click"
                        Style="{StaticResource RoundedButtonStyle}"><TextBlock Text="{loc:Tr 'Cancel'}" Margin="10,0"/></Button>
                <Button MinWidth="80" HorizontalAlignment="Center" Height="34"
                        IsDefault="True" Cursor="Hand"
                        Click="Add_Click"
                        Style="{StaticResource RoundedButtonStyle}"><TextBlock Text="{loc:Tr 'Add'}" Margin="10,0"/></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
