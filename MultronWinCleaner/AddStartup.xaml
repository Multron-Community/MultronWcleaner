<Window x:Class="MultronWinCleaner.AddStartup" Icon="pack://application:,,,/Assets/Icons/mwc_startup.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Add Startup Application'}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BevelBorder}" BorderThickness="1" SnapsToDevicePixels="True">
        <StackPanel>
            <DockPanel Height="56" Background="Transparent" Margin="18,0,8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" LastChildFill="False">
                <Image Source="pack://application:,,,/Assets/Icons/mwc_startup.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" DockPanel.Dock="Left"/>
                <TextBlock Text="{loc:Tr 'Add Startup Application'}" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <Button Content="&#xE8BB;" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
            </DockPanel>

            <TextBlock Margin="18,0,18,12" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                       Text="{loc:Tr 'The program will start automatically every time you sign in to Windows.'}"/>

            <Border Margin="14,0,14,14" Padding="14" CornerRadius="10" Background="{DynamicResource PanelBackground}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr 'Executable Path'}" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="34" Height="34" Padding="0" Margin="6,0,0,0" Content="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal"
                                Style="{DynamicResource UtilitySecondaryButtonStyle}" Click="Browse_Click" ToolTip="{loc:Tr 'Browse...'}"/>
                        <TextBox x:Name="txtPath" Style="{StaticResource FieldTextBoxStyle}"/>
                    </DockPanel>

                    <TextBlock Text="{loc:Tr 'Application Name'}" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,5"/>
                    <TextBox x:Name="txtName" Style="{StaticResource FieldTextBoxStyle}"/>

                    <TextBlock Text="{loc:Tr 'Startup Method'}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,7"/>
                    <WrapPanel>
                        <RadioButton x:Name="rbRegistry" Content="{loc:Tr 'Registry'}" IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,18,4" VerticalAlignment="Center" Checked="rbRegistry_Checked"/>
                        <RadioButton x:Name="rbTaskScheduler" Content="{loc:Tr 'Task Scheduler'}" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,18,4" VerticalAlignment="Center" Checked="rbTaskScheduler_Checked"/>
                        <RadioButton x:Name="rbWinLogon" Content="Userinit WinLogon" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,4" VerticalAlignment="Center" Checked="rbWinLogon_Checked"/>
                    </WrapPanel>
                    <TextBlock x:Name="MethodHint" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                               Text="{loc:Tr 'Starts when you sign in to Windows. Recommended for most programs.'}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,14">
                <Button Content="{loc:Tr 'Cancel'}" Height="36" MinWidth="96" Margin="0,0,8,0" Style="{DynamicResource UtilitySecondaryButtonStyle}" Click="CloseButton_Click" IsCancel="True"/>
                <Button Content="{loc:Tr 'Add'}" Height="36" MinWidth="104" Style="{DynamicResource UtilityPrimaryButtonStyle}" Click="Add_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
