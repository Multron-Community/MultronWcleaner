<Window Icon="pack://application:,,,/Assets/Icons/mwc_memory.ico" x:Class="MultronWinCleaner.MemoryMon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Memory Monitor'}"
        Height="Auto" Width="216"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        MouseDown="Window_DragMove"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="WidgetButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="6">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#26808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#33808080"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="#14808080"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,5,8,7"/>
        </Style>

        <Style x:Key="StatName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ListHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="PillLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="PillValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="PillDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="13,0,15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="19">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF2A8FE8" Offset="0"/>
                                        <GradientStop Color="#FF1976D2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Done" CornerRadius="19" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF34C77B" Offset="0"/>
                                        <GradientStop Color="#FF1E9E5C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Shine" CornerRadius="19" Opacity="0"/>
                            <Border x:Name="Glow" CornerRadius="19" Background="White" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRoundButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="Glow" Fill="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RingTrack" TargetType="Ellipse">
            <Setter Property="Stroke" Value="#26808080"/>
            <Setter Property="StrokeThickness" Value="4"/>
        </Style>

        <Style x:Key="RingValue" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource AccentColorBrush}"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeDashCap" Value="Round"/>
            <Setter Property="StrokeDashArray" Value="0 100"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="-90"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GaugeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="GaugeTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="2,0">
                            <Border x:Name="Bg" CornerRadius="8" Background="Transparent"/>
                            <Border x:Name="Bar" Height="3" CornerRadius="2" VerticalAlignment="Top" Margin="12,0" Background="{DynamicResource AccentColorBrush}" Visibility="Hidden"/>
                            <ContentPresenter Margin="0,10,0,8" HorizontalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1F1E88E5"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WidgetRoot">
        <Border x:Name="ClassicRoot" CornerRadius="10"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="8,5,8,8">

            <StackPanel>
                <Grid Margin="2,0,0,4">
                    <TextBlock Text="{loc:Tr 'PERFORMANCE'}" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button Style="{StaticResource WidgetCloseStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="RAM" Style="{StaticResource StatName}"/>
                                <TextBlock x:Name="RamPercentText" Text="0%" Style="{StaticResource StatValue}"/>
                            </Grid>
                            <ProgressBar x:Name="RamBar" Style="{StaticResource ModernProgressBar}" Foreground="#FF42A5F5"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="CPU" Style="{StaticResource StatName}"/>
                                <TextBlock x:Name="CpuPercentText" Text="0%" Style="{StaticResource StatValue}"/>
                            </Grid>
                            <ProgressBar x:Name="CpuBar" Style="{StaticResource ModernProgressBar}" Foreground="#FF28A745"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="DISK" Style="{StaticResource StatName}"/>
                                <TextBlock x:Name="DiskPercentText" Text="0%" Style="{StaticResource StatValue}"/>
                            </Grid>
                            <ProgressBar x:Name="DiskBar" Style="{StaticResource ModernProgressBar}" Foreground="#FF26C6DA"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatTile}" x:Name="NetTile">
                        <StackPanel>
                            <Grid Margin="0,0,0,1">
                                <TextBlock Text="NET" Style="{StaticResource StatName}"/>
                                <TextBlock x:Name="NetTotalText" Text="0 B/s" Style="{StaticResource StatValue}" FontSize="11.5"/>
                            </Grid>
                            <TextBlock x:Name="NetDetailText" Text="↓ 0 B/s  ↑ 0 B/s" FontSize="9" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="ClassicDetailsHost">
                    <StackPanel x:Name="DetailsPanel">
                        <UniformGrid Columns="2" Rows="1">
                            <Button Content="{loc:Tr 'Clean RAM'}" Margin="0,0,3,0"
                                    Style="{StaticResource WidgetButtonStyle}"
                                    Click="CleanMemory_Click"
                                    Background="#FF1E88E5" Foreground="White"/>
                            <Button Content="{loc:Tr 'Usage'}" Margin="3,0,0,0"
                                    Style="{StaticResource WidgetButtonStyle}"
                                    Click="SlowProcesses_Click"
                                    Background="#26808080" Foreground="{DynamicResource TextPrimary}"/>
                        </UniformGrid>

                        <TextBlock x:Name="FreedLabel"
                                   Text="" FontSize="10.5"
                                   Foreground="{DynamicResource NotifyCleanedAmountForeground}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid>
                            <ListView x:Name="ProcessesListView"
                                      Visibility="Collapsed"
                                      Height="130"
                                      Margin="0,6,0,0"
                                      Background="#14808080"
                                      Foreground="{DynamicResource TextPrimary}"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="6,2"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.Template>
                                    <ControlTemplate TargetType="ListView">
                                        <Border CornerRadius="7" Background="{TemplateBinding Background}" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="6,4,14,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="2" Text="{loc:Tr 'APP'}" Style="{StaticResource ListHeader}" Margin="2,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="CPU" Style="{StaticResource ListHeader}" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="RAM" Style="{StaticResource ListHeader}" TextAlignment="Right"/>
                                                </Grid>

                                                <Rectangle Grid.Row="0" Height="1" Fill="{DynamicResource TextSecondary}" Opacity="0.15" VerticalAlignment="Bottom" Margin="8,0"/>

                                                <ScrollViewer Grid.Row="1" Padding="0">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ListView.Template>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>
                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="9.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="2,0,2,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Cpu}" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Ram}" FontSize="9.5" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border x:Name="LoadingBorder"
                                    Height="130"
                                    Margin="0,6,0,0"
                                    Background="#14808080"
                                    CornerRadius="10"
                                    Visibility="Collapsed"
                                    IsVisibleChanged="LoadingBorder_IsVisibleChanged">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="22" Height="22" Margin="0,0,0,6">
                                        <Ellipse Stroke="{DynamicResource TextPrimary}" StrokeThickness="2" Opacity="0.2"/>
                                        <Path Data="M 11,2 A 9,9 0 0 1 20,11" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF1E88E5" Offset="0"/>
                                                    <GradientStop Color="#001E88E5" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Stroke>
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="LoadingSpinnerRotation" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <TextBlock x:Name="LoadingText" Text="{loc:Tr 'Loading...'}" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button x:Name="ClassicEndTaskButton" Content="{loc:Tr 'End Task'}" Margin="0,6,0,0" Visibility="Collapsed" IsEnabled="False"
                                Style="{StaticResource WidgetButtonStyle}" Background="#26DC3545" Foreground="{DynamicResource ResultProblemText}" Click="ClassicEndTask_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel x:Name="CompactRoot" Visibility="Collapsed" HorizontalAlignment="Left">
            <Border x:Name="CompactPill" CornerRadius="25" Padding="6,6,8,6" BorderThickness="1" Margin="6"
                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PillCleanButton" Height="38" Style="{StaticResource PillActionButton}" Click="CleanMemory_Click" ToolTip="{loc:Tr 'Clean RAM'}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="18" VerticalAlignment="Center">
                                <Canvas x:Name="PillBroom" Width="16" Height="18">
                                    <Path Data="M12.6,0.4 L14.2,1.3 L9.9,9.2 L8.3,8.3 Z" Fill="White"/>
                                    <Path Data="M5.2,8.2 L12.9,10.3 L11.6,17.6 L1.2,15.2 Z" Fill="White"/>
                                    <Path Data="M4.6,10.6 L3.4,15.4 M7.3,11.3 L6.6,16.2 M10,12 L9.6,16.9" Stroke="#FF1976D2" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path x:Name="PillSparkle" Data="M2.6,1 L3.2,2.5 L4.7,3.1 L3.2,3.7 L2.6,5.2 L2,3.7 L0.5,3.1 L2,2.5 Z" Fill="#FFFFE082"/>
                                </Canvas>
                                <TextBlock x:Name="PillCheck" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Grid>
                            <TextBlock Text="{loc:Tr 'Clean'}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="RAM" Style="{StaticResource PillLabel}" Foreground="{DynamicResource AccentText}"/>
                        <TextBlock Style="{StaticResource PillValue}"><Run x:Name="PillRamValue" Text="0"/><Run Text="%" FontSize="10"/></TextBlock>
                    </StackPanel>
                    <Rectangle Style="{StaticResource PillDivider}"/>
                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource PillLabel}" Foreground="{DynamicResource ResultSuccessText}"/>
                        <TextBlock Style="{StaticResource PillValue}"><Run x:Name="PillCpuValue" Text="0"/><Run Text="%" FontSize="10"/></TextBlock>
                    </StackPanel>
                    <Rectangle Style="{StaticResource PillDivider}"/>
                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="DISK" Style="{StaticResource PillLabel}" Foreground="{DynamicResource WidgetDiskText}"/>
                        <TextBlock Style="{StaticResource PillValue}"><Run x:Name="PillDiskValue" Text="0"/><Run x:Name="PillDiskUnit" Text="%" FontSize="10"/></TextBlock>
                    </StackPanel>
                    <Rectangle Style="{StaticResource PillDivider}"/>
                    <StackPanel x:Name="PillNetBlock" Margin="12,0,12,0" VerticalAlignment="Center" MinWidth="62" Background="Transparent">
                        <TextBlock Text="NET" Style="{StaticResource PillLabel}" Foreground="{DynamicResource BadgeWarningText}"/>
                        <TextBlock Style="{StaticResource PillValue}"><Run x:Name="PillNetValue" Text="0"/><Run x:Name="PillNetUnit" Text="B/s" FontSize="10"/></TextBlock>
                    </StackPanel>

                    <Button Width="30" Height="30" Margin="2,0,6,0" VerticalAlignment="Center" Background="#261E88E5"
                            Style="{StaticResource PillRoundButton}" Click="OpenMemoryCleaner_Click" ToolTip="{loc:Tr 'Open Memory Cleaner'}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentText}"/>
                    </Button>
                    <Button Width="26" Height="26" Margin="0" VerticalAlignment="Center" Background="#261E88E5"
                            Style="{StaticResource PillRoundButton}" Click="CompactToggle_Click" ToolTip="{loc:Tr 'Show details'}">
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentText}"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="CleanToast" Visibility="Collapsed" Margin="6,0,6,6" CornerRadius="12" BorderThickness="1" Padding="14,12,10,12"
                    Width="{Binding ActualWidth, ElementName=CompactPill}" HorizontalAlignment="Left"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WidgetCloseStyle}" VerticalAlignment="Top" Click="CloseToast_Click" ToolTip="{loc:Tr 'Close'}"/>
                    <Grid x:Name="ToastIcon" DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse x:Name="ToastRing" Stroke="{DynamicResource ResultSuccessText}" StrokeThickness="2" Opacity="0"/>
                        <Ellipse Fill="{DynamicResource ResultSuccessText}" Opacity="0.16"/>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource ResultSuccessText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr 'Memory Cleaned'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="ToastFreedText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ResultSuccessText}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="ToastRamText" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="ExpandedPanel" Visibility="Collapsed" Width="410" Margin="6" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="12,10,10,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource WidgetCloseStyle}" Width="24" Height="24" VerticalAlignment="Center" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
                        <Button DockPanel.Dock="Right" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center" Background="#261E88E5"
                                Style="{StaticResource PillRoundButton}" Click="CompactToggle_Click" ToolTip="{loc:Tr 'Hide details'}">
                            <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource AccentText}"/>
                        </Button>
                        <Image Source="pack://application:,,,/Assets/mwc_icon.ico" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{loc:Tr 'Performance Monitor'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <UniformGrid Columns="5" Margin="8,0,8,8">
                        <RadioButton GroupName="MonitorTab" Tag="ram" IsChecked="True" Style="{StaticResource GaugeTab}" Checked="GaugeTab_Checked">
                            <StackPanel>
                                <Grid Width="52" Height="52">
                                    <Ellipse Style="{StaticResource RingTrack}"/>
                                    <Ellipse x:Name="RamRing" Style="{StaticResource RingValue}"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"><Run x:Name="RamGaugeText" Text="0" FontSize="14"/><Run Text="%" FontSize="9"/></TextBlock>
                                </Grid>
                                <TextBlock Text="RAM" Style="{StaticResource GaugeLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MonitorTab" Tag="cpu" Style="{StaticResource GaugeTab}" Checked="GaugeTab_Checked">
                            <StackPanel>
                                <Grid Width="52" Height="52">
                                    <Ellipse Style="{StaticResource RingTrack}"/>
                                    <Ellipse x:Name="CpuRing" Style="{StaticResource RingValue}"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"><Run x:Name="CpuGaugeText" Text="0" FontSize="14"/><Run Text="%" FontSize="9"/></TextBlock>
                                </Grid>
                                <TextBlock Text="CPU" Style="{StaticResource GaugeLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MonitorTab" Tag="disk" Style="{StaticResource GaugeTab}" Checked="GaugeTab_Checked">
                            <StackPanel>
                                <Grid Width="52" Height="52">
                                    <Ellipse Style="{StaticResource RingTrack}"/>
                                    <Ellipse x:Name="DiskRing" Style="{StaticResource RingValue}"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"><Run x:Name="DiskGaugeText" Text="0" FontSize="14"/><Run x:Name="DiskGaugeUnit" Text="%" FontSize="9"/></TextBlock>
                                </Grid>
                                <TextBlock Text="DISK" Style="{StaticResource GaugeLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MonitorTab" Tag="net" Style="{StaticResource GaugeTab}" Checked="GaugeTab_Checked">
                            <StackPanel>
                                <Grid Width="52" Height="52">
                                    <Ellipse Style="{StaticResource RingTrack}"/>
                                    <Ellipse x:Name="NetRing" Style="{StaticResource RingValue}"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="NetGaugeText" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="NetGaugeUnit" Text="B/s" FontSize="8.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="NET" Style="{StaticResource GaugeLabel}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="MonitorTab" Tag="temp" Style="{StaticResource GaugeTab}" Checked="GaugeTab_Checked">
                            <StackPanel>
                                <Grid Width="52" Height="52">
                                    <Ellipse Style="{StaticResource RingTrack}"/>
                                    <Ellipse x:Name="TempRing" Style="{StaticResource RingValue}"/>
                                    <TextBlock x:Name="TempGlyph" Text="&#xE9CA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TempGaugeText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                </Grid>
                                <TextBlock Text="TEMP" Style="{StaticResource GaugeLabel}"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Border Margin="8,0,8,0" CornerRadius="8" Background="{DynamicResource SecondaryPanelBackground}">
                        <StackPanel>
                            <Grid Margin="12,8,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Tr 'Processes'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="ValueHeader" Grid.Column="1" Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="8,0"/>
                            <DockPanel Margin="12,6,12,4">
                                <TextBlock x:Name="ListTotal" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="8,0,6,0"/>
                                <TextBlock x:Name="ListSummary" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ListBox x:Name="MonitorList" Height="184" Margin="4,0,4,6" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{DynamicResource ResultListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="10,8,10,10">
                        <Button x:Name="EndTaskButton" DockPanel.Dock="Right" Content="{loc:Tr 'End Task'}" Height="30" MinWidth="96" IsEnabled="False"
                                Style="{DynamicResource UtilityDangerSoftButtonStyle}" Click="EndTask_Click"/>
                        <Button Height="30" Margin="0,0,8,0" Style="{StaticResource PillActionButton}" Click="CleanMemory_Click" ToolTip="{loc:Tr 'Clean RAM'}">
                            <StackPanel Orientation="Horizontal">
                                <Canvas Width="16" Height="18" VerticalAlignment="Center">
                                <Path Data="M12.6,0.4 L14.2,1.3 L9.9,9.2 L8.3,8.3 Z" Fill="White"/>
                                <Path Data="M5.2,8.2 L12.9,10.3 L11.6,17.6 L1.2,15.2 Z" Fill="White"/>
                                <Path Data="M4.6,10.6 L3.4,15.4 M7.3,11.3 L6.6,16.2 M10,12 L9.6,16.9" Stroke="#FF1976D2" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M2.6,1 L3.2,2.5 L4.7,3.1 L3.2,3.7 L2.6,5.2 L2,3.7 L0.5,3.1 L2,2.5 Z" Fill="#FFFFE082"/>
                            </Canvas>
                                <TextBlock Text="{loc:Tr 'Clean RAM'}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Width="30" Height="30" Margin="0,0,8,0" Style="{StaticResource PillRoundButton}" Background="#261E88E5" Click="OpenMemoryCleaner_Click" ToolTip="{loc:Tr 'Open Memory Cleaner'}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentText}"/>
                        </Button>
                        <TextBlock x:Name="MonitorStatus" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
