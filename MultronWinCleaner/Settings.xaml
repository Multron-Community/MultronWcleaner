<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="MultronWinCleaner.Settings"
        Title="{loc:Tr 'Settings'}" Height="750" Width="850" MinHeight="420" MinWidth="620" Icon="pack://application:,,,/Assets/mwc_icon.ico"
        WindowStyle="None" ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource WindowBackground}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        AllowsTransparency="True"
        FontFamily="Inter, Segoe UI, Arial, sans-serif"
        TextElement.Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" CornerRadius="4" Background="{DynamicResource TextPrimary}" Opacity="0.25" Margin="2,0,2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>

                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="thumbBorderH" CornerRadius="4" Background="{DynamicResource TextPrimary}" Opacity="0.25" Margin="0,2,0,2"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbBorderH" Property="Opacity" Value="0.55"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="thumbBorderH" Property="Opacity" Value="0.80"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DropShadowEffect x:Key="DropShadowSoft" Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.28" />

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FF1E88E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1976D2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1565C0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FFF57C00" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFF9800" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEF6C00" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FFDC3545" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Effect="{StaticResource DropShadowSoft}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE4606D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFB02A37" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,4,18,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource TextBoxBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{TemplateBinding Header}"
                                           FontSize="15" FontWeight="Bold"
                                           Margin="18,14,18,10"/>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="5"
                                    Background="{DynamicResource TextBoxBackground}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M2,7 L6,11 L13,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" Stretch="Uniform" Margin="3"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FF1E88E5"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF1E88E5"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF1E88E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CustomRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Ellipse x:Name="OuterRing"
                       Width="18"
                       Height="18"
                       Stroke="#1E88E5"
                       StrokeThickness="2"
                       Fill="Transparent"
                       VerticalAlignment="Center"/>

                            <Ellipse x:Name="InnerDot"
                       Width="10"
                       Height="10"
                       Fill="#1E88E5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotScale" ScaleX="0" ScaleY="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.RenderTransformOrigin>
                                    <Point X="0.5" Y="0.5"/>
                                </Ellipse.RenderTransformOrigin>
                            </Ellipse>

                            <ContentPresenter Grid.Column="1"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                HorizontalAlignment="Left"/>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#42A5F5"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}" />

            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />

            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF1E88E5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}"/>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#FF1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" Focusable="True" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220" Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="24" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Border x:Name="WindowFrame" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="22"
                Margin="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="28,22,20,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr 'Settings'}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="{loc:Tr 'Manage cleaning, scanning, startup and notification preferences'}"
                                   FontSize="13" Opacity="0.6"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,26">
                        <Button Content="↺"
                                Style="{DynamicResource ModernButtonStyle}"
                                Width="30" Height="30" FontSize="15" Padding="0"
                                Click="ResetToDefaults_Click"
                                ToolTip="{loc:Tr 'Reset to defaults'}"
                                Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="—"
                                Style="{DynamicResource ModernButtonStyle}"
                                Width="30" Height="30" FontSize="13" Padding="0"
                                Click="MinimizeButton_Click"
                                ToolTip="{loc:Tr 'Minimize'}"
                                Cursor="Hand" Margin="0,0,8,0"/>
                        <Button x:Name="MaximizeButton" Content="⤢"
                                Style="{DynamicResource ModernButtonStyle}"
                                Width="30" Height="30" FontSize="15" Padding="0"
                                Click="MaximizeButton_Click"
                                ToolTip="{loc:Tr 'Maximize/Restore'}"
                                Cursor="Hand" Margin="0,0,8,0"/>
                        <Button Content="✕"
                                Style="{DynamicResource DangerButtonStyle}"
                                Width="30" Height="30" FontSize="14"
                                Click="CloseButton_Click"
                                ToolTip="{loc:Tr 'Close'}"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="28,0,20,24">

                        <TextBlock Text="{loc:Tr 'Changes are saved automatically.'}"
                                   FontSize="12" Opacity="0.55" Margin="2,0,0,14"/>

                        <GroupBox Header="{loc:Tr 'App Updates'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock x:Name="txtAppVersion" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtAppUpdateStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="btnCheckAppUpdate" Content="{loc:Tr 'Check for Updates'}" Style="{DynamicResource ModernButtonStyle}"
                                            Padding="16,8" Margin="0,0,10,6" Click="CheckAppUpdate_Click"/>
                                    <Button x:Name="btnInstallAppUpdate" Style="{DynamicResource AccentButtonStyle}" Padding="16,8" Margin="0,0,10,6"
                                            Visibility="Collapsed" Click="InstallAppUpdate_Click"/>
                                    <Button x:Name="btnAppReleasePage" Content="{loc:Tr 'Release Notes'}" Style="{DynamicResource ModernButtonStyle}"
                                            Padding="16,8" Margin="0,0,10,6" Visibility="Collapsed" Click="AppReleasePage_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Windows Startup'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="chkRunAtStartup" Content="{loc:Tr 'Start Multron Win Cleaner when I sign in to Windows'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"
                                          Checked="ChkRunAtStartup_Changed" Unchecked="ChkRunAtStartup_Changed"/>
                                <TextBlock Text="{loc:Tr 'Starts in the background in the system tray, without a permission prompt. Needed for the automatic scan and cleanup at startup.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'System Tray'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="chkTrayIcon" Content="{loc:Tr 'Show a tray icon for quick access'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"
                                          />
                                <TextBlock Text="{loc:Tr 'Lets you open, pause or exit Multron Cleaner from the system tray.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="26,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Language'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <ComboBox x:Name="cmbLanguage" Height="34" Width="460"
                                          HorizontalAlignment="Left" Padding="8"
                                          FontSize="15" FontWeight="Medium"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="cmbLanguage_SelectionChanged"/>
                                <TextBlock Text="{loc:Tr 'The app restarts to apply the new language.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Interface Mode'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <RadioButton x:Name="rbSimpleInterface" Content="{loc:Tr 'Simplified (recommended)'}"
                                             GroupName="InterfaceMode" IsChecked="True" FontSize="14"
                                             Foreground="{DynamicResource TextPrimary}" Style="{DynamicResource CustomRadioButtonStyle}"
                                             Cursor="Hand" Checked="InterfaceMode_Changed"/>
                                <TextBlock Text="{loc:Tr 'One cleaning list for all users, split into Windows and Applications. Items show plain names, the paths are in their tooltips. Commands and extra scans are listed with easy names.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,12"/>
                                <RadioButton x:Name="rbAdvancedInterface" Content="{loc:Tr 'Advanced'}"
                                             GroupName="InterfaceMode" FontSize="14"
                                             Foreground="{DynamicResource TextPrimary}" Style="{DynamicResource CustomRadioButtonStyle}"
                                             Cursor="Hand" Checked="InterfaceMode_Changed"/>
                                <TextBlock Text="{loc:Tr 'The same look in full detail: a separate group for every user, every item on its own row with its full path, the raw commands and all database buttons.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>
                                <TextBlock Text="{loc:Tr 'The cleaning list reloads when you change this.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Theme'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="chkThemeFollowsWindows" Content="{loc:Tr 'Match the Windows theme'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="True"
                                          Checked="ChkThemeFollowsWindows_Changed" Unchecked="ChkThemeFollowsWindows_Changed"/>
                                <TextBlock Text="{loc:Tr 'Dark when Windows uses dark mode, light otherwise, and changes along with Windows. Using the theme switch on the main window turns this off.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,14"/>

                                <CheckBox x:Name="chkTransparency" Content="{loc:Tr 'Transparency effects'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"
                                          Checked="Transparency_Changed" Unchecked="Transparency_Changed"/>
                                <TextBlock Text="{loc:Tr 'Window backgrounds are slightly see-through and tinted with the color below.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,10"/>
                                <WrapPanel Margin="26,0,0,0">
                                    <StackPanel Margin="0,0,16,6">
                                        <TextBlock Text="{loc:Tr 'Color'}" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmbTransparencyColor" Width="180" Height="34" FontSize="14"
                                                  Style="{DynamicResource ModernComboBoxStyle}"
                                                  SelectionChanged="Transparency_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{loc:Tr 'Strength'}" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmbTransparencyLevel" Width="180" Height="34" FontSize="14"
                                                  Style="{DynamicResource ModernComboBoxStyle}"
                                                  SelectionChanged="Transparency_Changed">
                                            <ComboBoxItem Content="{loc:Tr 'Light'}"/>
                                            <ComboBoxItem Content="{loc:Tr 'Medium'}"/>
                                            <ComboBoxItem Content="{loc:Tr 'Strong'}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'User Profile Selection'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Choose which Windows user profile the cleaner should target:'}"
                   FontSize="14" Opacity="0.75"
                   Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <RadioButton x:Name="rbCleanAllUsers" 
             Content="{loc:Tr 'Clean all user profiles'}" 
             IsChecked="True" 
             FontSize="14" 
             Foreground="{DynamicResource TextPrimary}" 
             Style="{DynamicResource CustomRadioButtonStyle}" 
             Margin="0,0,0,10" 
             Cursor="Hand"/>
                                <RadioButton x:Name="rbCleanSelectedUsers" 
Content="{loc:Tr 'Clean selected user profiles'}" 
IsChecked="False" 
FontSize="14" 
Foreground="{DynamicResource TextPrimary}" 
Style="{DynamicResource CustomRadioButtonStyle}" 
Margin="0,0,0,10" 
Cursor="Hand"/>

                                <ComboBox x:Name="comboBoxUserSelection" Height="34"
                  HorizontalAlignment="Stretch"
                  Padding="8"
                  FontSize="15" FontWeight="Medium">
                                    <ComboBox.Style> 
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
                                            <Style.Triggers> 
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=chkCleanAllUsers}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                <Button x:Name="ApplyButton" Content="{loc:Tr 'Apply Selection'}" Width="140" Height="34" Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Click="ApplyUserSelection_Click"
                Style="{DynamicResource AccentButtonStyle}"
                FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Secure Deletion (Shredding)'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'For privacy, overwrite files before deleting them during cleaning so they cannot be recovered. SSD-aware: on a solid-state drive the extra passes are skipped (they cannot target the same memory cells and only wear the drive); after deletion the TRIM command discards the blocks.'}"
                                           FontSize="14" Opacity="0.75" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <ComboBox x:Name="cmbShredMode" Height="34" Width="460" HorizontalAlignment="Left" Padding="8"
                                          FontSize="15" FontWeight="Medium" SelectionChanged="ShredMode_Changed"
                                          Style="{DynamicResource ModernComboBoxStyle}">
                                    <ComboBoxItem Content="{loc:Tr 'Off — normal delete (fastest)'}"/>
                                    <ComboBoxItem Content="{loc:Tr 'Automatic — SSD-aware (recommended)'}"/>
                                    <ComboBoxItem Content="{loc:Tr '1 pass (fast)'}"/>
                                    <ComboBoxItem Content="{loc:Tr '3 passes (DoD 5220.22-M)'}"/>
                                    <ComboBoxItem Content="{loc:Tr '7 passes (thorough)'}"/>
                                </ComboBox>
                                <TextBlock Text="{loc:Tr 'Shredding rewrites every file, so cleaning takes longer the more passes you choose.'}"
                                           FontSize="12" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Cleanup Log'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>

                                <CheckBox x:Name="chkEnableLog" Content="{loc:Tr 'Keep a cleanup log'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" />
                                <TextBlock Text="{loc:Tr 'Records every cleaning operation performed by the app.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkShowLastLog" Content="{loc:Tr 'Show the last log entry in the status bar'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" />
                                <TextBlock Text="{loc:Tr 'Displays the most recent log line without opening the log file.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="26,2,0,16"/>

                                <TextBlock Text="{loc:Tr 'Log file location'}" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtLogPath" Grid.Column="0"
                                             Style="{DynamicResource RoundedTextBox}"
                                             Height="40" FontSize="13"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,10,0"
                                            />
                                    <Button Content="{loc:Tr 'Browse'}" Grid.Column="1"
                                            Width="90" Height="40"
                                            Click="BrowseLogPath_Click"
                                            Style="{DynamicResource ModernButtonStyle}"
                                            FontWeight="SemiBold" Cursor="Hand"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnOpenLog" Content="{loc:Tr 'Open Log File'}"
                                            Width="150" Height="34"
                                            Click="OpenLogFile_Click"
                                            Style="{DynamicResource ModernButtonStyle}"
                                            FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>
                                    <Button x:Name="btnOpenAppFolder" Content="{loc:Tr 'Open Folder'}"
                                            Width="150" Height="34"
                                            Click="OpenAppFolder_Click"
                                            Style="{DynamicResource ModernButtonStyle}"
                                            FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>
                                    <Button x:Name="btnClearLog" Content="{loc:Tr 'Clear Log File'}"
                                            Width="120" Height="34"
                                            Click="ClearLog_Click"
                                            Style="{DynamicResource CancelButtonStyle}"
                                            FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>
                                    <Button x:Name="btnApplyLog" Content="{loc:Tr 'Apply'}"
                                            Width="120" Height="34"
                                            Click="ApplyLog_Click"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            FontWeight="SemiBold" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Scanner Settings'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel Margin="0,0,36,0">

                                    <TextBlock Text="{loc:Tr 'Limit what the scanner looks at, so it only flags files that actually matter.'}"
                                               FontSize="13" Opacity="0.6"
                                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Border Background="{DynamicResource TextBoxBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <CheckBox x:Name="OldScan"
                                                      Content="{loc:Tr 'Only scan files older than a set number of days'}"
                                                      Checked="OldScan_Checked"
                                                      Style="{DynamicResource CustomCheckBoxStyle}"
                                                      FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="cmbAgePreset" Grid.Column="0"
                                                          Height="32" Padding="8,0" FontSize="14"
                                                          VerticalContentAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          Style="{DynamicResource ModernComboBoxStyle}"
                                                          IsEnabled="{Binding IsChecked, ElementName=OldScan}">
                                                    <ComboBoxItem Content="{loc:Tr '7 days'}" Tag="7"/>
                                                    <ComboBoxItem Content="{loc:Tr '30 days (1 month)'}" Tag="30" IsSelected="True"/>
                                                    <ComboBoxItem Content="{loc:Tr '90 days (3 months)'}" Tag="90"/>
                                                    <ComboBoxItem Content="{loc:Tr 'Custom'}" Tag="0"/>
                                                </ComboBox>
                                                <TextBox x:Name="txtCustomDay" Grid.Column="1"
                                                         Height="32" Padding="8,0" FontSize="14"
                                                         VerticalContentAlignment="Center"
                                                         Text="32"
                                                         IsEnabled="{Binding IsChecked, ElementName=OldScan}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbAgePreset}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Grid.Column="2" Text="{loc:Tr 'days'}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbAgePreset}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource TextBoxBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <CheckBox x:Name="AccessScan"
                                                      Checked="AccessScan_Checked"
                                                      Style="{DynamicResource CustomCheckBoxStyle}"
                                                      FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10">
                                                <CheckBox.Content>
                                                    <loc:Tr Text="Only scan files that haven't been opened recently"/>
                                                </CheckBox.Content>
                                            </CheckBox>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="cmbAccessPreset" Grid.Column="0"
                                                          Height="32" Padding="8,0" FontSize="14"
                                                          VerticalContentAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          Style="{DynamicResource ModernComboBoxStyle}"
                                                          IsEnabled="{Binding IsChecked, ElementName=AccessScan}">
                                                    <ComboBoxItem Content="{loc:Tr '7 days'}" Tag="7"/>
                                                    <ComboBoxItem Content="{loc:Tr '30 days (1 month)'}" Tag="30" IsSelected="True"/>
                                                    <ComboBoxItem Content="{loc:Tr '90 days (3 months)'}" Tag="90"/>
                                                    <ComboBoxItem Content="{loc:Tr 'Custom'}" Tag="0"/>
                                                </ComboBox>
                                                <TextBox x:Name="txtCustomAccess" Grid.Column="1"
                                                         Height="32" Padding="8,0" FontSize="14"
                                                         VerticalContentAlignment="Center"
                                                         Text="32"
                                                         IsEnabled="{Binding IsChecked, ElementName=AccessScan}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbAccessPreset}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Grid.Column="2" Text="{loc:Tr 'days ago'}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbAccessPreset}" Value="3">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{loc:Tr 'Deep Log Scanner — File Extensions'}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{loc:Tr 'Extra extensions the deep scan should also treat as log/temp files.'}"
                                               FontSize="12" Opacity="0.55"
                                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtNewExtension" Grid.Column="0"
                                                 Height="34" VerticalContentAlignment="Center" FontSize="14" Padding="8,0"
                                                 Style="{DynamicResource RoundedTextBox}"
                                                 Text=".log.etl.dmp.trace.tmp.temp.bak.swp"
                                                 ToolTip="{loc:Tr 'Example: .crash'}"
                                                 Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Content="{loc:Tr 'Add'}" Width="70" Height="34"
                                                Click="AddExtension_Click"
                                                Style="{DynamicResource AccentButtonStyle}" Margin="0,0,10,0"/>
                                        <Button Grid.Column="2" Content="{loc:Tr 'Reset'}" Width="70" Height="34"
                                                Click="ResetExtensions_Click"
                                                Style="{DynamicResource CancelButtonStyle}"/>
                                    </Grid>
                                </StackPanel>

                                <Button x:Name="btnScannerHelp"
                                        Content="?" Width="26" Height="26"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        FontSize="14" FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="btnScannerHelp_Click"
                                        ToolTip="{loc:Tr 'How does this work?'}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="13">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </GroupBox>


                        <GroupBox Header="{loc:Tr 'Startup &amp; Notify Settings'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>

                                <CheckBox x:Name="chkEnableStartupScan" Content="{loc:Tr 'Automatically scan when the app starts'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"
                                          Checked="ChkEnableStartupScan_Checked"/>
                                <TextBlock Text="{loc:Tr 'Runs a scan every time Multron Cleaner launches.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkEnableStartupClean" Content="{loc:Tr 'Automatically clean when the app starts'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"
                                          Checked="ChkEnableStartupClean_Checked"/>
                                <TextBlock Text="{loc:Tr 'Runs a cleanup after scan.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkEnableNotifyScan" Content="{loc:Tr 'Notify me after a background scan finishes'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="True"/>
                                <TextBlock Text="{loc:Tr 'Shows a toast notification once a background scan completes.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkEnableNotifyClean" Content="{loc:Tr 'Notify me after a background cleanup finishes'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="True"/>
                                <TextBlock Text="{loc:Tr 'Shows a toast notification once a background cleanup completes.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkNotifySecurity" Content="{loc:Tr 'Notify me about security problems found by a background scan'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"/>
                                <TextBlock Text="{loc:Tr 'Shows a notification when an automatic or startup scan finds settings that make Windows less secure.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkNotifyFirewall" Content="{loc:Tr 'Notify me about broken firewall rules found by a background scan'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"/>
                                <TextBlock Text="{loc:Tr 'Shows a notification when an automatic or startup scan finds firewall rules for programs that no longer exist.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkNotifyDuplicates" Content="{loc:Tr 'Notify me about duplicate files found by a background scan'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"/>
                                <TextBlock Text="{loc:Tr 'Shows a notification when an automatic or startup scan finds duplicate files in your personal folders.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkNotifyMalware" Content="{loc:Tr 'Notify me about malware scan results from a background scan'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"/>
                                <TextBlock Text="{loc:Tr 'Shows a notification with the result when a malware scan started by an automatic or startup scan finishes.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,12"/>

                                <TextBlock Text="{loc:Tr 'Notification position'}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cmbNotifyPosition" Width="220" Height="34" HorizontalAlignment="Left"
                                          FontSize="14" FontWeight="Medium" SelectedIndex="0"
                                          Style="{DynamicResource ModernComboBoxStyle}">
                                    <ComboBoxItem Content="{loc:Tr 'Bottom right'}"/>
                                    <ComboBoxItem Content="{loc:Tr 'Bottom left'}"/>
                                    <ComboBoxItem Content="{loc:Tr 'Top right'}"/>
                                    <ComboBoxItem Content="{loc:Tr 'Top left'}"/>
                                </ComboBox>
                                <TextBlock Text="{loc:Tr 'The corner of the screen where notifications appear.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="0,4,0,12"/>

                                <TextBlock Text="{loc:Tr 'Notification layout'}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6"/>
                                <ComboBox x:Name="cmbNotifyLayout" Width="320" Height="34" HorizontalAlignment="Left"
                                          FontSize="14" FontWeight="Medium" SelectedIndex="0"
                                          Style="{DynamicResource ModernComboBoxStyle}">
                                    <ComboBoxItem Content="{loc:Tr 'Lined up, one above the other'}"/>
                                    <ComboBoxItem Content="{loc:Tr 'Overlapping, on top of each other'}"/>
                                </ComboBox>
                                <TextBlock Text="{loc:Tr 'When several notifications are open: lined up so none of them is covered, or in the same place with the newest one in front.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Right-Click Menu'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="chkContextMenuScan" Content="{loc:Tr 'Add Scan with Multron Malware Scan to the right-click menu'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"
                                          Checked="ChkContextMenuScan_Changed" Unchecked="ChkContextMenuScan_Changed"/>
                                <TextBlock Text="{loc:Tr 'Right-click a file, folder or drive in File Explorer to check it with the cloud malware scan. To scan several items at once, select them and use Send To, Multron Malware Scan.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,12"/>

                                <CheckBox x:Name="chkClassicContextMenu" Content="{loc:Tr 'Use the classic right-click menu in Windows 11'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}"
                                          Checked="ChkClassicContextMenu_Changed" Unchecked="ChkClassicContextMenu_Changed"/>
                                <TextBlock x:Name="txtClassicContextMenuHint" Text="{loc:Tr 'Windows 11 shows items added by programs only under Show more options. With the classic menu they appear in the first menu, as in Windows 10. This changes the menu for every program and takes effect after File Explorer restarts.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Automatic Cleaning'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel Margin="0,0,36,0">

                                    <CheckBox Content="{loc:Tr 'Enable automatic cleaning'}" x:Name="chkAutoClean"
                                              Style="{DynamicResource CustomCheckBoxStyle}"
                                              FontSize="15" FontWeight="SemiBold"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="{loc:Tr 'Runs cleaning automatically based on the schedule and conditions below.'}"
                                               FontSize="12" Opacity="0.55"
                                               Margin="26,0,0,14" TextWrapping="Wrap"/>

                                    <Border Background="{DynamicResource TextBoxBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'Run only when:'}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="SkipBattery" Content="{loc:Tr 'Battery is above 30%'}"
                                                      Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="RunIfInactive" Content="{loc:Tr 'User has been inactive for at least 15 minutes'}"
                                                      Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="OnlyBattery" Content="{loc:Tr 'Device is plugged in and charging'}"
                                                      Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="OnlyLowCPU" Content="{loc:Tr 'CPU usage is below 30%'}"
                                                      Style="{DynamicResource CustomCheckBoxStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{loc:Tr 'After cleaning'}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbPostCleanupAction" Width="240" Height="34" HorizontalAlignment="Left"
                                              Margin="0,0,0,16" FontSize="14" FontWeight="Medium" SelectedIndex="0"
                                              Style="{DynamicResource ModernComboBoxStyle}">
                                        <ComboBoxItem Content="{loc:Tr 'Do Nothing'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Shutdown'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Restart'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Log Off'}"/>
                                    </ComboBox>

                                    <TextBlock Text="{loc:Tr 'Run schedule'}" FontSize="14" FontWeight="Medium" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbScheduleType" Width="220" Height="34" HorizontalAlignment="Left"
                                              Margin="0,0,0,14" FontSize="14" FontWeight="Medium" SelectedIndex="1"
                                              Style="{DynamicResource ModernComboBoxStyle}">
                                        <ComboBoxItem Content="{loc:Tr 'Every X minutes'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Daily'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Weekly'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Custom Days'}"/>

                                    </ComboBox>

                                    <WrapPanel Margin="0,0,0,14" HorizontalAlignment="Left">
                                        <WrapPanel.Style>
                                            <Style TargetType="WrapPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbScheduleType}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </WrapPanel.Style>
                                        <CheckBox x:Name="Day7" Content="{loc:Tr 'Monday'}"    Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                        <CheckBox x:Name="Day6" Content="{loc:Tr 'Tuesday'}"   Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                        <CheckBox x:Name="Day5" Content="{loc:Tr 'Wednesday'}" Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                        <CheckBox x:Name="Day4" Content="{loc:Tr 'Thursday'}"  Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                        <CheckBox x:Name="Day3" Content="{loc:Tr 'Friday'}"    Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                        <CheckBox x:Name="Day2" Content="{loc:Tr 'Saturday'}"  Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                        <CheckBox x:Name="Day1" Content="{loc:Tr 'Sunday'}"    Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                    </WrapPanel>
                                    <StackPanel Margin="0,0,0,14" HorizontalAlignment="Left">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbScheduleType}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <CheckBox x:Name="chkLimitWeeks" Content="{loc:Tr 'Only in selected weeks of the month'}" Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="26,0,0,0">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkLimitWeeks}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <CheckBox x:Name="Week1" Content="{loc:Tr '1st week (days 1-7)'}" IsChecked="True" Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="Week2" Content="{loc:Tr '2nd week (days 8-14)'}" IsChecked="True" Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="Week3" Content="{loc:Tr '3rd week (days 15-21)'}" IsChecked="True" Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="Week4" Content="{loc:Tr '4th week (days 22-28)'}" IsChecked="True" Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="Week5" Content="{loc:Tr '5th week (days 29-31)'}" IsChecked="True" Style="{DynamicResource CustomCheckBoxStyle}" Margin="0,0,14,8"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbScheduleType}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbScheduleType}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{loc:Tr 'Cleaning interval (minutes):'}" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Medium"/>
                                        <TextBox x:Name="txtCleaningInterval" Width="100" Text="60"
                                                 Style="{DynamicResource RoundedTextBox}"
                                                 PreviewTextInput="txtCleaningInterval_PreviewTextInput" Margin="12,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbScheduleType}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbScheduleType}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=cmbScheduleType}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{loc:Tr 'Allowed time range:'}" FontSize="14"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Medium"/>
                                        <TextBox x:Name="txtStartTime" Width="100" Text="08:00"
                                                 Style="{DynamicResource RoundedTextBox}" Margin="12,0,0,0"/>
                                        <TextBlock Text="–" FontSize="14" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtEndTime" Width="100" Text="22:00"
                                                 Style="{DynamicResource RoundedTextBox}"/>
                                    </StackPanel>

                                    <TextBlock x:Name="txtStat" FontSize="14" FontWeight="SemiBold"
                                               Opacity="0.7"
                                               Text="{loc:Tr 'Status: 00:00'}"/>
                                </StackPanel>

                                <Button x:Name="btnAutoCleanHelp"
                                        Content="?" Width="26" Height="26"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        FontSize="14" FontWeight="Bold"
                                        Cursor="Hand"
                                        Click="btnAutoCleanHelp_Click"
                                        ToolTip="{loc:Tr 'How does this work?'}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="13">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Network'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="chkOfflineMode" Content="{loc:Tr 'Offline mode'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="false"
                                          Checked="chkOfflineMode_Changed" Unchecked="chkOfflineMode_Changed"/>
                                <TextBlock Text="{loc:Tr 'Skips waiting for an internet connection and the update / database download at startup. Takes effect the next time the app starts.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>

                                <CheckBox x:Name="chkAppAutoUpdate" Content="{loc:Tr 'Check for app updates automatically'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="true" Margin="0,14,0,0"
                                          Checked="DatabaseUpdateSetting_Changed" Unchecked="DatabaseUpdateSetting_Changed"/>
                                <TextBlock Text="{loc:Tr 'Checks for a new Multron Win Cleaner version at startup and while the app stays open. A new version found in the background is installed only when you click its notification.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>

                                <CheckBox x:Name="chkDatabaseAutoUpdate" Content="{loc:Tr 'Keep the database up to date automatically'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="true" Margin="0,14,0,0"
                                          Checked="DatabaseUpdateSetting_Changed" Unchecked="DatabaseUpdateSetting_Changed"/>
                                <TextBlock Text="{loc:Tr 'Checks for a newer database before manual and automatic scans and in the background while the app stays open. Not used in offline mode.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="26,8,0,0">
                                    <TextBlock Text="{loc:Tr 'Check for updates every:'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="cmbDatabaseUpdateHours" Height="34" Width="160"
                                              Padding="8" FontSize="14" FontWeight="Medium"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              SelectionChanged="DatabaseUpdateHours_SelectionChanged"/>
                                </StackPanel>

                                <CheckBox x:Name="chkDatabaseAutoReload" Content="{loc:Tr 'Load a database downloaded in the background automatically'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="true" Margin="26,10,0,0"
                                          Checked="DatabaseUpdateSetting_Changed" Unchecked="DatabaseUpdateSetting_Changed"/>
                                <TextBlock Text="{loc:Tr 'When this is off, a new database is loaded right before the next scan or when you click Reload Database.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="52,2,0,0"/>

                                <CheckBox x:Name="chkDatabaseUpdateStatus" Content="{loc:Tr 'Show database update status on the main screen'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="true" Margin="0,10,0,0"
                                          Checked="DatabaseUpdateSetting_Changed" Unchecked="DatabaseUpdateSetting_Changed"/>
                                <TextBlock Text="{loc:Tr 'A warning is still shown when the database has not been updated for a long time.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>

                                <CheckBox x:Name="chkDatabaseUpdateButton" Content="{loc:Tr 'Show the Update Database button on the main screen'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="true" Margin="0,10,0,0"
                                          Checked="DatabaseUpdateSetting_Changed" Unchecked="DatabaseUpdateSetting_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Selections'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="chkAutoSaveSelections" Content="{loc:Tr 'Save selections automatically'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="true"
                                          Checked="chkAutoSaveSelections_Changed" Unchecked="chkAutoSaveSelections_Changed"/>
                                <TextBlock Text="{loc:Tr 'Saves your checkbox choices to selections.txt as soon as you change them. The Save Selections button is hidden while this is on.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Browsers'}" Style="{DynamicResource CustomGroupBoxStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox x:Name="chkCleanAllBrowserProfiles" Content="{loc:Tr 'Clean all browser profiles'}"
                                          Style="{DynamicResource CustomCheckBoxStyle}" IsChecked="true"
                                          Checked="chkCleanAllBrowserProfiles_Changed" Unchecked="chkCleanAllBrowserProfiles_Changed"/>
                                <TextBlock Text="{loc:Tr 'Adds every profile of each browser to the cleaning list. Turn this off to choose one profile per browser from a list inside its group. The cleaning list reloads when you change this.'}"
                                           FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                           Margin="26,2,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Tr 'Exceptions'}" Style="{DynamicResource CustomGroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr 'Files and folders listed here will never be touched by the cleaner.'}"
                                           FontSize="12" Opacity="0.55"
                                           Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtExceptionPath" Grid.Column="0"
                                             Style="{DynamicResource ModernTextBoxStyle}"
                                             Height="34" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button Content="{loc:Tr 'Add'}" Grid.Column="1" Width="64" Height="34"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Click="AddException_Click" Margin="0,0,8,0"
                                            FontWeight="SemiBold" Cursor="Hand"/>
                                    <Button Content="{loc:Tr 'Remove'}" Grid.Column="2" Width="75" Height="34"
                                            Style="{DynamicResource ModernButtonStyle}"
                                            Click="RemoveException_Click" Margin="0,0,8,0"
                                            FontWeight="SemiBold" Cursor="Hand"/>
                                    <Button Content="{loc:Tr 'Remove All'}" Grid.Column="3" Width="90" Height="34"
                                            Style="{DynamicResource CancelButtonStyle}"
                                            Click="RemoveExceptionAll_Click"
                                            FontWeight="SemiBold" Cursor="Hand"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                        Background="{DynamicResource TextBoxBackground}" Padding="8">
                                    <ListBox x:Name="lstExceptions" Height="145" FontSize="15"
                                             Background="{DynamicResource TextBoxBackground}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
