<Window x:Class="MultronWinCleaner.StartupManager" Icon="pack://application:,,,/Assets/Icons/mwc_startup.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Startup Manager'}" Height="640" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="14" Padding="13,5" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#14808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#261E88E5"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#991E88E5"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{DynamicResource PanelBackground}" MouseDown="TopBar_MouseDown" LastChildFill="False">
            <Image Source="pack://application:,,,/Assets/Icons/mwc_startup.png" Width="28" Height="28" Margin="16,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" DockPanel.Dock="Left"/>
            <TextBlock Text="{loc:Tr 'Multron Startup Manager'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Click="MinimizeButton_Click" ToolTip="{loc:Tr 'Minimize'}" Margin="0,0,6,0"/>
                <Button Content="&#xE922;" Style="{DynamicResource ChromeButtonStyle}" Click="MaximizeButton_Click" ToolTip="{loc:Tr 'Maximize/Restore'}" Margin="0,0,6,0"/>
                <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" Padding="16,14,16,10" Margin="10,12,10,0" CornerRadius="12">
            <DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border x:Name="HighImpactBadge" Visibility="Collapsed" CornerRadius="10" Padding="9,2" Margin="12,0,0,0" Background="#26DC3545" VerticalAlignment="Center">
                            <TextBlock x:Name="HighImpactText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerText}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button MinWidth="80" Height="32" Style="{DynamicResource RoundedButtonStyle}" Margin="0,0,8,0" Click="AddButton_Click" Cursor="Hand"><TextBlock Text="{loc:Tr 'Add'}" Margin="10,0"/></Button>
                        <Button MinWidth="113" Height="32" Style="{DynamicResource RoundedButtonStyle}" Click="AddOperationButton_Click" Cursor="Hand"><TextBlock Text="{loc:Tr 'Add Operation'}" Margin="10,0"/></Button>
                    </StackPanel>
                </DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource FilterChipStyle}" GroupName="StartupFilter" Tag="All" IsChecked="True" Checked="Filter_Checked" Content="{loc:Tr 'All'}"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="StartupFilter" Tag="Enabled" Checked="Filter_Checked" Content="{loc:Tr 'Enabled'}"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="StartupFilter" Tag="Disabled" Checked="Filter_Checked" Content="{loc:Tr 'Disabled'}"/>
                        <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="StartupFilter" Tag="High" Checked="Filter_Checked" Content="{loc:Tr 'High impact'}"/>
                        <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="2,0,10,0"/>
                        <ToggleButton x:Name="chkWindowsTasks" Style="{StaticResource FilterChipStyle}" Checked="WindowsTasks_Changed" Unchecked="WindowsTasks_Changed" Content="{loc:Tr 'Windows tasks'}"
                                      ToolTip="{loc:Tr 'Also show the scheduled tasks Windows uses for itself.'}"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Height="32" Width="220" CornerRadius="16" VerticalAlignment="Center"
                            Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="0.85">
                        <Grid Margin="12,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.55" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{loc:Tr 'Search Application...'}" Margin="8,0,0,0" FontSize="12.5" Opacity="0.45"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            <Button x:Name="SearchClear" Grid.Column="2" Content="✕" Width="22" Height="22" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextPrimary}" Click="SearchClear_Click" ToolTip="{loc:Tr 'Clear'}"/>
                        </Grid>
                    </Border>
                </DockPanel>

                <Grid>
                    <DataGrid x:Name="StartupAppsDataGrid"
                              ItemsSource="{Binding StartupApps}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              Foreground="{DynamicResource TextPrimary}"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              FontSize="14"
                              MinRowHeight="58"
                              SelectionUnit="FullRow"
                              SelectionChanged="StartupAppsDataGrid_SelectionChanged">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Tr 'Open file location'}" Click="StartupOpenLocation_Click"/>
                                <MenuItem Header="{loc:Tr 'Copy path'}" Click="StartupCopyPath_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#14808080"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1F1E88E5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{Binding FlashBrush, TargetNullValue=Transparent}" Padding="4,0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Tr 'Enabled'}" Width="84" SortMemberPath="PendingEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding ToggleHint}" ToolTipService.ShowOnDisabled="True" Background="Transparent" HorizontalAlignment="Left">
                                            <ToggleButton Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding PendingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCheckboxEnabled}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:Tr 'Name'}" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="10" Background="#14808080" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource PanelBackground}" CornerRadius="10">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:Tr 'Startup Type'}" Width="140" SortMemberPath="StartupTypeText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StartupTypeText, Mode=OneWay}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:Tr 'Impact'}" Width="96" SortMemberPath="ImpactScore">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Pill" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#262EB872"
                                                ToolTip="{loc:Tr 'Estimated from the size of the program and the files it loads when it starts.'}">
                                            <TextBlock x:Name="PillText" Text="{Binding ImpactText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ResultSuccessText}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EffectiveImpact}" Value="None">
                                                <Setter TargetName="Pill" Property="Background" Value="#26808080"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EffectiveImpact}" Value="High">
                                                <Setter TargetName="Pill" Property="Background" Value="#26DC3545"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource DangerText}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EffectiveImpact}" Value="Medium">
                                                <Setter TargetName="Pill" Property="Background" Value="#26FB8C00"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource WarningText}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="48" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="RemoveRow" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="32" Height="32" Cursor="Hand"
                                                Click="RemoveButton_Click" ToolTip="{loc:Tr 'Remove'}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#26DC3545"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerText}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                <Setter TargetName="RemoveRow" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="LoadingOverlay" Background="{DynamicResource PanelBackground}" Opacity="0.9" Visibility="Collapsed" CornerRadius="5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr 'Loading Apps...'}" FontSize="16" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <ProgressBar IsIndeterminate="True" Width="150" Height="4" Style="{DynamicResource ModernLinearProgressStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#2B2B2B"
                BorderBrush="#FFB900"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15,10"
                Margin="20,20,20,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Visibility="{Binding WarningVisibility}"
                Panel.ZIndex="999"
                MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" BlurRadius="15" Opacity="0.4" Direction="270" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FFB900" FontSize="22" VerticalAlignment="Center" Margin="0,0,15,0"/>


                <TextBlock Grid.Column="1"
                           Text="{Binding WarningMessage}"
                           Foreground="#EAEAEA"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="2"
                        Content="✕"
                        Background="Transparent"
                        Foreground="#888888"
                        BorderThickness="0"
                        FontSize="16"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="CloseWarning_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" Padding="16,12" Margin="10,12,10,10" CornerRadius="12">
            <DockPanel LastChildFill="False">
                <Button x:Name="btnApply" DockPanel.Dock="Right" MinWidth="140" Height="34" IsEnabled="False" Style="{DynamicResource RoundedButtonStyle}" Click="ApplyButton_Click" Cursor="Hand">
                    <TextBlock x:Name="ApplyText" Text="{loc:Tr 'Apply changes'}" Margin="12,0"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <ToggleButton x:Name="tglShowNotifications" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="tglShowNotifications_Checked" Unchecked="tglShowNotifications_Unchecked"/>
                    <TextBlock Text="{loc:Tr 'Show notification when a startup app is added in background'}" FontSize="13.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
