<Window x:Class="MultronWinCleaner.StartupManager" Icon="pack://application:,,,/Assets/mwc_utilities.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Startup Manager'}" Height="624" Width="900"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI" 
        AllowsTransparency="True" 
        WindowStyle="None" 
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
 
        <DockPanel Grid.Row="0" Background="{DynamicResource PanelBackground}" MouseDown="TopBar_MouseDown" LastChildFill="False">
            <TextBlock Text="{loc:Tr 'Multron Startup Manager'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Click="MinimizeButton_Click" ToolTip="{loc:Tr 'Minimize'}" Margin="0,0,6,0"/>
                <Button Content="&#xE922;" Style="{DynamicResource ChromeButtonStyle}" Click="MaximizeButton_Click" ToolTip="{loc:Tr 'Maximize/Restore'}" Margin="0,0,6,0"/>
                <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
            </StackPanel>
        </DockPanel>

       
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" Padding="10" Margin="10,15,10,0" CornerRadius="10">
            <DockPanel>
 
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                 
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button MinWidth="80" HorizontalAlignment="Center" Height="30" Style="{DynamicResource RoundedButtonStyle}" Margin="0,0,8,0" Click="AddButton_Click" Cursor="Hand"><TextBlock Text="{loc:Tr 'Add'}" Margin="10,0"/></Button>
                        <Button x:Name="btnRemove" MinWidth="80" HorizontalAlignment="Center" Height="30" Style="{DynamicResource RoundedButtonStyle}" IsEnabled="False" Margin="0,0,8,0" Click="RemoveButton_Click" Cursor="Hand"><TextBlock Text="{loc:Tr 'Remove'}" Margin="10,0"/></Button>

                        <Button x:Name="btnApply" MinWidth="80" HorizontalAlignment="Center" Height="30" Style="{DynamicResource RoundedButtonStyle}" Margin="0,0,8,0" Click="ApplyButton_Click" Cursor="Hand"><TextBlock Text="{loc:Tr 'Apply'}" Margin="10,0"/></Button>
                        <Button MinWidth="113" HorizontalAlignment="Center" Height="30" Style="{DynamicResource RoundedButtonStyle}" Click="AddOperationButton_Click" Cursor="Hand"><TextBlock Text="{loc:Tr 'Add Operation'}" Margin="10,0"/></Button>
                    </StackPanel>
 
                    <Border DockPanel.Dock="Right" Height="32" Width="240" CornerRadius="16" VerticalAlignment="Center"
                            Background="{DynamicResource TextBoxBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="0.85">
                        <Grid Margin="12,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.55" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{loc:Tr 'Search Application...'}" Margin="8,0,0,0" FontSize="12.5" Opacity="0.45"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            <Button x:Name="SearchClear" Grid.Column="2" Content="✕" Width="22" Height="22" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextPrimary}" Click="SearchClear_Click" ToolTip="{loc:Tr 'Clear'}"/>
                        </Grid>
                    </Border>
                </DockPanel>
 
                <Grid>
                    <DataGrid x:Name="StartupAppsDataGrid"
                              ItemsSource="{Binding StartupApps}"
                              AutoGenerateColumns="False"
                              AlternationCount="2"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Foreground="{DynamicResource TextPrimary}"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              FontSize="14"
                              SelectionUnit="FullRow"
                              SelectionChanged="StartupAppsDataGrid_SelectionChanged">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource RowBackground}"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource AlternateRowBackground}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedRowBackground}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Tr 'Enabled'}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PendingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCheckboxEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:Tr 'Icon'}" Width="Auto" MinWidth="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Tr 'Name'}" Binding="{Binding Name}" Width="*"
                                                CellStyle="{StaticResource ClickableCellStyle}"
                                                ElementStyle="{StaticResource ClickableTextStyle}" />

                            <DataGridTextColumn Header="{loc:Tr 'Path'}" Binding="{Binding Path}" Width="2*"
                                                CellStyle="{StaticResource ClickableCellStyle}"
                                                ElementStyle="{StaticResource ClickableTextStyle}" />

                            <DataGridTextColumn Header="{loc:Tr 'Status'}" Binding="{Binding StatusText, Mode=OneWay}" Width="100"
                                                CellStyle="{StaticResource ClickableCellStyle}"
                                                ElementStyle="{StaticResource ClickableTextStyle}" />

                            <DataGridTextColumn Header="{loc:Tr 'Startup Type'}" Binding="{Binding StartupTypeText, Mode=OneWay}" Width="150"
                                                CellStyle="{StaticResource ClickableCellStyle}"
                                                ElementStyle="{StaticResource ClickableTextStyle}" />
 
                            <DataGridTemplateColumn Header="{loc:Tr 'Impact'}" Width="100" SortMemberPath="ImpactScore">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ImpactText}" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#28A745"/>
                                            
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Impact}" Value="High">
                                                            <Setter Property="Foreground" Value="#DC3545"/>
                                                       
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                            <Setter Property="Foreground" Value="#FF9800"/>
                                                         
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="LoadingOverlay" Background="{DynamicResource PanelBackground}" Opacity="0.9" Visibility="Collapsed" CornerRadius="5">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr 'Loading Apps...'}" FontSize="16" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <ProgressBar IsIndeterminate="True" Width="150" Height="4" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
 
        <Border Grid.RowSpan="3"
                Background="#2B2B2B" 
                BorderBrush="#FFB900" 
                BorderThickness="1"
                CornerRadius="8" 
                Padding="15,10" 
                Margin="20,20,20,40" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                Visibility="{Binding WarningVisibility}"
                Panel.ZIndex="999"
                MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" BlurRadius="15" Opacity="0.4" Direction="270" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
 
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FFB900" FontSize="22" VerticalAlignment="Center" Margin="0,0,15,0"/>

              
                <TextBlock Grid.Column="1" 
                           Text="{Binding WarningMessage}" 
                           Foreground="#EAEAEA" 
                           VerticalAlignment="Center" 
                           FontSize="13" 
                           TextWrapping="Wrap"/>
 
                <Button Grid.Column="2" 
                        Content="✕" 
                        Background="Transparent" 
                        Foreground="#888888" 
                        BorderThickness="0" 
                        FontSize="16" 
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Hand" 
                        Click="CloseWarning_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" Padding="15" Margin="10,15,10,10" CornerRadius="10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="tglShowNotifications" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Checked="tglShowNotifications_Checked" Unchecked="tglShowNotifications_Unchecked"/>
                <TextBlock Text="{loc:Tr 'Show notification when a startup app is added in background'}" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
