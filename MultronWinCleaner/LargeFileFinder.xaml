<Window
    x:Class="MultronWinCleaner.LargeFileFinder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
    Title="{loc:Tr 'Large File Finder'}"
    Height="800" Width="1000"
    WindowStyle="None"
    ResizeMode="CanResizeWithGrip"
    AllowsTransparency="True"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowBackground}">

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{DynamicResource PanelBackground}" VerticalAlignment="Top" LastChildFill="False" MouseDown="TopBar_MouseDown" Height="46">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{loc:Tr 'Multron Large File Finder'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Content="&#xE921;" Style="{DynamicResource ChromeButtonStyle}" Click="MinimizeButton_Click" ToolTip="{loc:Tr 'Minimize'}" Margin="0,0,6,0"/>
                <Button Content="&#xE922;" Style="{DynamicResource ChromeButtonStyle}" x:Name="buttonMaximize" Click="MaximizeButton_Click" ToolTip="{loc:Tr 'Maximize/Restore'}" Margin="0,0,6,0"/>
                <Button Content="&#xE8BB;" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,10">
            <Button Name="StartScan" Click="StartScan_Click" Width="100" Height="100" Cursor="Hand" BorderThickness="0" Margin="0,0,0,10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="CircleBg" Fill="#1E88E5">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3" Color="#1E88E5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBg" Property="Fill" Value="#42A5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CircleBg" Property="Fill" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{loc:Tr 'SCAN'}" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </Button>

            <TextBlock x:Name="ScanResultLabel" Text="{loc:Tr 'Ready to scan'}" 
                       FontStyle="Italic" HorizontalAlignment="Center" Foreground="{DynamicResource Text}" FontSize="13"/>

            <ProgressBar x:Name="ScanProgressBar" Height="6" Width="300" Margin="0,10,0,0"
                         Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="20,0,20,10" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="10">
            <Expander x:Name="PropertiesExpander" IsExpanded="False" Background="Transparent" BorderThickness="0">
                <Expander.Header>
                    <TextBlock Text="{loc:Tr '▼ Advanced Search Settings (Folders, Exclusions, File Types &amp; Filters)'}" Foreground="#1E88E5" FontWeight="SemiBold" FontSize="14" Cursor="Hand"/>
                </Expander.Header>

                <Grid Margin="10,12,10,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{loc:Tr 'Target Directories (Scan):'}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource Text}"/>
                        <ListBox x:Name="FolderListBox" Height="85"
                                 Background="{DynamicResource TextBoxBackground}"
                                 Foreground="{DynamicResource Text}"
                                 BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Click="AddFolder_Click" MinWidth="100" HorizontalAlignment="Center" Height="28" Margin="0,0,6,0" Style="{DynamicResource ModernButtonStyle}"><TextBlock Text="{loc:Tr '+ Add Folder'}" Margin="10,0"/></Button>
                            <Button Click="RemoveSelectedFolder_Click" MinWidth="80" HorizontalAlignment="Center" Height="28" Style="{DynamicResource DangerButtonStyle}"><TextBlock Text="{loc:Tr 'Remove'}" Margin="10,0"/></Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{loc:Tr 'Excluded Directories (Skip):'}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource Text}"/>
                        <ListBox x:Name="ExcludedFolderListBox" Height="85"
                                 Background="{DynamicResource TextBoxBackground}"
                                 Foreground="{DynamicResource Text}"
                                 BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Click="AddExcludedFolder_Click" MinWidth="110" HorizontalAlignment="Center" Height="28" Margin="0,0,6,0" Style="{DynamicResource ModernButtonStyle}"><TextBlock Text="{loc:Tr '+ Exclude Folder'}" Margin="10,0"/></Button>
                            <Button Click="RemoveSelectedExcludedFolder_Click" MinWidth="80" HorizontalAlignment="Center" Height="28" Style="{DynamicResource DangerButtonStyle}"><TextBlock Text="{loc:Tr 'Remove'}" Margin="10,0"/></Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="10" Background="{DynamicResource WindowBackground}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Tr 'Min Size Threshold:'}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource Text}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{loc:Tr 'Min Size:'}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBox x:Name="SizeThresholdTextBox" Grid.Column="1" Text="100" Height="28"
                                             FontSize="13" FontWeight="Bold" Padding="5,2,5,2" VerticalContentAlignment="Center"
                                             Background="{DynamicResource TextBoxBackground}" Foreground="{DynamicResource Text}" 
                                             BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"/>

                                    <ComboBox x:Name="SizeUnitComboBox" Grid.Column="2" Width="70" Style="{DynamicResource ModernComboBoxStyle}" Height="28" Margin="6,0,0,0" SelectedIndex="1" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="KB"/>
                                        <ComboBoxItem Content="MB"/>
                                        <ComboBoxItem Content="GB"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Tr 'File Age / Date Limit:'}" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="EnableDateFilterCheckBox" Content="{loc:Tr 'Enable'}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                              FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="DateTypeComboBox" Grid.Column="0" Height="28" Style="{DynamicResource ModernComboBoxStyle}" SelectedIndex="0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="{loc:Tr 'Last Accessed'}"/>
                                        <ComboBoxItem Content="{loc:Tr 'Last Modified'}"/>
                                    </ComboBox>

                                    <TextBox x:Name="DaysOldTextBox" Grid.Column="1" Text="30" Height="28" Margin="6,0,0,0"
                                             FontSize="13" FontWeight="Bold" Padding="5,2,5,2" VerticalContentAlignment="Center"
                                             Background="{DynamicResource TextBoxBackground}" Foreground="{DynamicResource Text}" 
                                             BorderBrush="{DynamicResource BorderBrush}"/>

                                    <TextBlock Grid.Column="2" Text="{loc:Tr 'days old or older'}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Text}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="10" Background="{DynamicResource WindowBackground}" CornerRadius="6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{loc:Tr 'File Types / Categories to Include:'}" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Click="SelectAllCategories_Click" MinWidth="75" HorizontalAlignment="Center" Height="22" FontSize="11" Margin="0,0,5,0" Style="{DynamicResource ModernButtonStyle}"><TextBlock Text="{loc:Tr 'Select All'}" Margin="10,0"/></Button>
                                    <Button Click="DeselectAllCategories_Click" MinWidth="80" HorizontalAlignment="Center" Height="22" FontSize="11" Style="{DynamicResource ModernButtonStyle}"><TextBlock Text="{loc:Tr 'Deselect All'}" Margin="10,0"/></Button>
                                </StackPanel>
                            </DockPanel>

                            <WrapPanel Name="CategoryWrapPanel">
                                <CheckBox x:Name="ChkVideos" Content="{loc:Tr 'Videos (.mp4, .mkv, .avi, .ts...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkMusic" Content="{loc:Tr 'Music (.mp3, .wav, .flac, .opus...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkPhotos" Content="{loc:Tr 'Photos (.jpg, .png, .heic, .raw...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkArchives" Content="{loc:Tr 'Archives (.zip, .rar, .7z, .zst...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkDocuments" Content="{loc:Tr 'Documents (.pdf, .docx, .epub, .pst...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkPrograms" Content="{loc:Tr 'Programs and Installers (.exe, .msi, .msix, .apk...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkDiskImages" Content="{loc:Tr 'Disk Images and VMs (.iso, .vhdx, .vmdk, .wim...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkBackups" Content="{loc:Tr 'Backups, Dumps and Logs (.bak, .dmp, .log, .db...)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                                <CheckBox x:Name="ChkOthers" Content="{loc:Tr 'Others (Other extensions)'}" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,0,20,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Expander>
        </Border>

        <Grid Grid.Row="3" Margin="20,0,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{loc:Tr 'Large Files Found'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <Button Click="ClearListButton_Click" MinWidth="90" HorizontalAlignment="Center" Height="26" DockPanel.Dock="Right" Style="{DynamicResource DangerButtonStyle}"><TextBlock Text="{loc:Tr 'Clear List'}" Margin="10,0"/></Button>
            </DockPanel>

            <DataGrid x:Name="LargeFilesDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{DynamicResource DataGridBackground}" Foreground="{DynamicResource Text}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      RowBackground="{DynamicResource DataGridRowBackground}"
                      AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBackground}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      IsReadOnly="True" Sorting="LargeFilesDataGrid_Sorting">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Tr 'Open File'}" Click="OpenFile_Click"/>
                        <MenuItem Header="{loc:Tr 'Open File Location'}" Click="OpenFileLocation_Click"/>
                        <Separator/>
                        <MenuItem Header="{loc:Tr 'Copy File Path'}" Click="CopyFilePath_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr 'File Name'}" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn x:Name="SizeColumn" Header="{loc:Tr 'Size'}" Binding="{Binding FormattedSize}" Width="100"/>
                    <DataGridTextColumn Header="{loc:Tr 'Last Used / Access'}" Binding="{Binding TimeAgo}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Tr 'Last Modified'}" Binding="{Binding FormattedLastModified}" Width="135"/>
                    <DataGridTextColumn Header="{loc:Tr 'Path'}" Binding="{Binding Path}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
