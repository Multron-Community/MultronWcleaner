<Window x:Class="MultronWinCleaner.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="Inter, Segoe UI, Arial, sans-serif"
        KeyDown="Window_KeyDown">
    <Grid x:Name="Dimmer" Background="#A0000000">
        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Margin="20"
                Background="{DynamicResource PanelBackground}" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.30"/>
            </Border.Effect>
            <Border Background="#10000000" CornerRadius="16" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <Border x:Name="IconBorder" Width="40" Height="40" CornerRadius="20" Background="#201E88E5" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock x:Name="IconText" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="#1E88E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24">
                        <TextBox x:Name="MessageText" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 IsTabStop="False" Cursor="Arrow"/>
                    </ScrollViewer>
                    <TextBox x:Name="InputBox" Visibility="Collapsed" Margin="0,-12,0,24" MinHeight="80" MaxHeight="160"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Style="{DynamicResource ModernTextBoxStyle}"/>
                    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
