<Window x:Class="MultronWinCleaner.AddBootOperationWindow" Icon="pack://application:,,,/Assets/mwc_utilities.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Add Boot Operation'}"
        Height="420" Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        AllowsTransparency="True">

    <Border CornerRadius="12" 
            Background="{DynamicResource WindowBackground}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            Padding="10"
            SnapsToDevicePixels="True">

        <DockPanel>

            <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource AccentColorBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{loc:Tr 'Add Boot Operation'}" 
                           VerticalAlignment="Center" 
                           Margin="12,0,0,0" 
                           Foreground="{DynamicResource AccentTextBrush}"
                           FontWeight="SemiBold"
                           FontSize="14" />

                <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource AccentTextBrush}" 
                        FontWeight="Bold"
                        FontSize="16"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip="{loc:Tr 'Close'}">
                    ×
                </Button>
            </Grid>

            <StackPanel Margin="0,15,0,0" VerticalAlignment="Top">

                <ComboBox x:Name="cmbOperationType" Height="32" Margin="0,0,0,10" Style="{DynamicResource ModernComboBoxStyle}">
                    <ComboBoxItem Content="{loc:Tr 'Delete'}" />
                    <ComboBoxItem Content="{loc:Tr 'Move'}" />
                    <ComboBoxItem Content="{loc:Tr 'Rename'}" />
                    <ComboBoxItem Content="{loc:Tr 'ManualCommand'}" />
                </ComboBox>

                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="txtSourcePath" Background="{DynamicResource TextBoxBackground}" Foreground="{DynamicResource TextBoxForeground}" />
                    <TextBlock Text="{loc:Tr 'Source file/folder path'}"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource WatermarkBrush}"
                               Margin="5,2,0,0"
                               VerticalAlignment="Center"
                               Padding="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSourcePath}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSourcePath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSourcePath}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="txtDestPath" IsEnabled="False"
                             Background="{DynamicResource TextBoxBackground}" Foreground="{DynamicResource TextBoxForeground}" />
                    <TextBlock Text="{loc:Tr 'Destination path (for Move/Rename)'}"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource WatermarkBrush}"
                               Margin="5,2,0,0"
                               VerticalAlignment="Center"
                               Padding="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtDestPath}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtDestPath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtDestPath}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="txtManualCommand" Height="60" TextWrapping="Wrap"
                             Background="{DynamicResource TextBoxBackground}" Foreground="{DynamicResource TextBoxForeground}" IsEnabled="False"/>
                    <TextBlock Text="{loc:Tr 'Manual command (for ManualCommand operation)'}"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource WatermarkBrush}"
                               Margin="5,2,0,0"
                               VerticalAlignment="Top"
                               Padding="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtManualCommand}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtManualCommand}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtManualCommand}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ListBox x:Name="lstBootOperations" Height="120" Margin="0,0,0,10"
             Background="{DynamicResource TextBoxBackground}"
             Foreground="{DynamicResource TextBoxForeground}">
                 
                </ListBox>

               
               
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button Content="{loc:Tr 'Run Command'}" Click="RunCommand_Click" Margin="0,0,10,0" Padding="6,2" MinWidth="100" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
                    <Button Content="{loc:Tr 'Add'}" Click="Add_Click" MinWidth="80" HorizontalAlignment="Center" Padding="6,2"
                            Background="{DynamicResource AccentColorBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
                </StackPanel>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>
