<Window x:Class="MultronWinCleaner.AddBootOperationWindow" Icon="pack://application:,,,/Assets/Icons/mwc_startup.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultronWinCleaner"
        Title="{loc:Tr 'Add Boot Operation'}"
        Height="660" Width="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="BootFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BootInputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BootListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="8" Margin="0,0,0,6" Padding="10,8" BorderThickness="1" BorderBrush="Transparent" Background="{DynamicResource SecondaryPanelBackground}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="Transparent" Margin="18,0,8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" LastChildFill="False">
                <Image Source="pack://application:,,,/Assets/Icons/mwc_startup.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" DockPanel.Dock="Left"/>
                <TextBlock Text="{loc:Tr 'Add Boot Operation'}" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <Button Content="&#xE8BB;" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{DynamicResource ChromeCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{loc:Tr 'Close'}"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Margin="18,0,18,12" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                       Text="{loc:Tr 'These operations run the next time Windows starts. Nothing changes until you schedule them.'}"/>

            <Border Grid.Row="2" Margin="14,0,14,10" Padding="14" CornerRadius="10" Background="{DynamicResource PanelBackground}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr 'Operation'}" Style="{StaticResource BootFieldLabelStyle}"/>
                    <ComboBox x:Name="cmbOperationType" Height="34" Style="{DynamicResource ModernComboBoxStyle}" SelectionChanged="CmbOperationType_SelectionChanged">
                        <ComboBoxItem Content="{loc:Tr 'Delete'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Move'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Rename'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Manual command'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Run a program'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Empty a folder'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Repair system files (SFC)'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Repair Windows image (DISM)'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Clear temporary files'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Clear Windows Update cache'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Reset network settings'}"/>
                        <ComboBoxItem Content="{loc:Tr 'Empty Recycle Bin'}"/>
                    </ComboBox>

                    <StackPanel x:Name="SourcePanel" Margin="0,12,0,0">
                        <TextBlock x:Name="SourceLabel" Text="{loc:Tr 'File or folder'}" Style="{StaticResource BootFieldLabelStyle}"/>
                        <DockPanel>
                            <Button x:Name="SourceFolderButton" DockPanel.Dock="Right" Width="34" Height="34" Padding="0" Margin="6,0,0,0" Content="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal" Style="{DynamicResource UtilitySecondaryButtonStyle}" Click="BrowseSourceFolder_Click" ToolTip="{loc:Tr 'Select a folder'}"/>
                            <Button x:Name="SourceFileButton" DockPanel.Dock="Right" Width="34" Height="34" Padding="0" Margin="6,0,0,0" Content="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal" Style="{DynamicResource UtilitySecondaryButtonStyle}" Click="BrowseSourceFile_Click" ToolTip="{loc:Tr 'Select a file'}"/>
                            <TextBox x:Name="txtSourcePath" Style="{StaticResource BootInputStyle}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="DestinationPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="DestinationLabel" Text="{loc:Tr 'Destination'}" Style="{StaticResource BootFieldLabelStyle}"/>
                        <DockPanel>
                            <Button x:Name="DestinationBrowseButton" DockPanel.Dock="Right" Width="34" Height="34" Padding="0" Margin="6,0,0,0" Content="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal" Style="{DynamicResource UtilitySecondaryButtonStyle}" Click="BrowseDestination_Click" ToolTip="{loc:Tr 'Select a folder'}"/>
                            <TextBox x:Name="txtDestPath" Style="{StaticResource BootInputStyle}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="CommandPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="CommandLabel" Text="{loc:Tr 'Command'}" Style="{StaticResource BootFieldLabelStyle}"/>
                        <TextBox x:Name="txtManualCommand" Height="62" Padding="8,6" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Style="{StaticResource BootInputStyle}"/>
                        <TextBlock Text="{loc:Tr 'Runs once the next time an administrator signs in.'}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <Button Content="{loc:Tr 'Add'}" Height="34" MinWidth="104" Margin="0,14,0,0" HorizontalAlignment="Right" Style="{DynamicResource UtilityPrimaryButtonStyle}" Click="Add_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="14,0,14,10" Padding="14,12,14,8" CornerRadius="10" Background="{DynamicResource PanelBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr 'Planned operations'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                    <Grid>
                        <TextBlock x:Name="EmptyListText" Text="{loc:Tr 'No operations yet. Add one above.'}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                        <ListBox x:Name="lstBootOperations" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource BootListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Width="28" Height="26" Padding="0" Margin="10,0,0,0" VerticalAlignment="Center" Content="✕" Tag="{Binding}" Style="{DynamicResource UtilityQuietButtonStyle}" Click="RemoveOperation_Click" ToolTip="{loc:Tr 'Remove'}"/>
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TypeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Scheduled">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource UtilityDangerText}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DetailsText}" ToolTip="{Binding DetailsText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="18,0,18,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,14">
                <Button x:Name="RunNowButton" Content="{loc:Tr 'Run Selected Now'}" Height="36" MinWidth="120" Margin="0,0,8,0" Style="{DynamicResource UtilitySecondaryButtonStyle}" Click="RunNow_Click"/>
                <Button Content="{loc:Tr 'Schedule for Next Restart'}" Height="36" MinWidth="170" Style="{DynamicResource UtilityPrimaryButtonStyle}" Click="Schedule_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
